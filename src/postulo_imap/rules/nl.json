{
  "language": "nl",
  "name": "Nederlands",
  "dates": [
    "\\b(\\d{1,2}[-/.]\\d{1,2}[-/.]\\d{2,4})(?:\\s*,?\\s*(?:om\\s*)?(\\d{1,2}[:.]\\d{2}))?",
    "\\b(\\d{4}-\\d{2}-\\d{2})(?:[ T](\\d{1,2}:\\d{2}))?",
    "\\b(\\d{1,2}\\s+(?:januari|februari|maart|april|mei|juni|juli|augustus|september|oktober|november|december)(?:\\s+\\d{4})?)(?:\\s*,?\\s*(?:om\\s*)?(\\d{1,2}[:.]\\d{2}))?"
  ],
  "kinds": [
    {
      "kind": "offer",
      "patterns": [
        "de (functie|baan|positie) aan(bieden|te bieden)",
        "(bieden|aanbieden) (wij|we) (je|jou|u) .{0,30}(functie|baan|positie)",
        "aanbod voor de functie",
        "arbeidsvoorwaarden(gesprek|voorstel)",
        "contractvoorstel"
      ]
    },
    {
      "kind": "rejected",
      "patterns": [
        "helaas.{0,60}niet (verder|door)",
        "moeten (wij|we) (je|u) (helaas )?(mededelen|teleurstellen)",
        "niet (geselecteerd|uitgenodigd)",
        "gaan (wij|we) niet verder met (je|jouw|uw) sollicitatie",
        "gekozen voor een andere kandidaat",
        "past niet bij (het|dit) profiel"
      ]
    },
    {
      "kind": "interview",
      "patterns": [
        "uitnodigen voor een (gesprek|kennismaking|interview)",
        "uitnodiging voor een (gesprek|kennismaking)",
        "(kennismakings|sollicitatie)gesprek",
        "(een )?afspraak (in )?(te )?plannen",
        "ben (je|u) beschikbaar op"
      ]
    },
    {
      "kind": "assessment",
      "patterns": [
        "(online|technische)\\s*(test|assessment|opdracht)",
        "(test|opdracht|casus) .{0,30}(maken|afronden|uitwerken)",
        "vragenlijst in(te )?vullen",
        "assessment[-\\s]?center"
      ]
    },
    {
      "kind": "acknowledged",
      "patterns": [
        "bedankt voor (je|jouw|uw) (sollicitatie|interesse)",
        "(wij|we) hebben (je|jouw|uw) sollicitatie .{0,20}ontvangen",
        "(je|jouw|uw) sollicitatie is ontvangen",
        "ontvangstbevestiging",
        "(wij|we) (bekijken|beoordelen) (je|jouw|uw) sollicitatie"
      ]
    }
  ]
}
