#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d کو کسی درخواست سے ملایا نہیں جا سکا؛ اسے دستی طور پر منسلک کریں۔"
msgstr[1] "%(count)d کو کسی درخواست سے ملایا نہیں جا سکا؛ انہیں دستی طور پر منسلک کریں۔"

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d پیغام پڑھا نہیں جا سکا اور چھوڑ دیا گیا۔"
msgstr[1] "%(count)d پیغامات پڑھے نہیں جا سکے اور چھوڑ دیے گئے۔"

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "بغیر موضوع کا پیغام"

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "a rejection"
msgstr "انکار"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "پہلے سے ملائے گئے پیغام کا جواب"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "وصولی کی تصدیق"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "ایپ پاس ورڈ، جہاں بھی سرور یہ سہولت دیتا ہو؛ دو مرحلہ تصدیق آن ہونے پر Gmail اس کا تقاضا کرتا ہے۔ انکرپٹ کر کے محفوظ کیا جاتا ہے۔"

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "تشخیصی ٹیسٹ"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "ایک دعوت"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "پیشکش"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "سرور تک رسائی نہیں ہو سکی۔ پتہ، پورٹ اور سیکیورٹی چیک کریں۔"

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "اسے %(keyword)s سے فلیگ کریں"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "زیادہ تر کلائنٹس میں فلیگ نظر نہیں آتا اور اس سے ہر پاس مختصر رہتا ہے۔ میل باکس کو جوں کا توں چھوڑنے کا مطلب ہے کہ ہر پاس صرف وہی پیغامات پڑھتا ہے جو پچھلے پاس کے بعد آئے ہوں؛ دونوں صورتوں میں کوئی چیز دو بار تجویز نہیں کی جاتی۔"

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "پڑھنے کے لیے فولڈر"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "مثلاً imap.example.org۔"

#: src/postulo_imap/sync.py
msgid "From"
msgstr "منجانب"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "1 اور %(max)d کے درمیان دنوں کی تعداد درج کریں۔"

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "1 سے 65535 کے درمیان پورٹ دیں، یا اسے خالی چھوڑ دیں۔"

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "ایک دور میں کتنے دنوں کی میل دیکھی جاتی ہے۔"

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "میل باکس کو جوں کا توں چھوڑیں"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "خالی چھوڑنے پر: TLS کے ساتھ 993، STARTTLS کے ساتھ 143۔"

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "پیچھے دیکھنے کی مدت"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "میل بکس (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "مطابقت کی بنیاد"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "اسے ذیلی فولڈر میں منتقل کریں"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "پڑھے جانے والے فولڈر کے علاوہ کوئی ذیلی فولڈر بتائیں۔"

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "پڑھنے کے لیے فولڈر کا نام دیں۔ Postulo کبھی ان باکس نہیں پڑھتا۔"

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "وہ ذیلی فولڈر بتائیں جس میں پیغامات منتقل کیے جائیں۔"

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "ابھی تک کچھ نہیں"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "پڑھنے کے بعد"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "ایک فولڈر، کبھی ان باکس نہیں۔ اپنے میل سرور پر ایک اصول بنائیں جو بھرتی کرنے والوں کی میل یہاں رکھے؛ Postulo اور کچھ نہیں پڑھتا۔ جو بھی پیغام یہ پڑھتا ہے اسے بعد میں فلیگ یا منتقل کر دیا جاتا ہے، چاہے اسے پہچانا گیا ہو یا نہیں۔"

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "پاس ورڈ یا ایپ پاس ورڈ"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "پورٹ"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo کبھی ان باکس نہیں پڑھتا۔ اس فولڈر کا نام دیں جس میں آپ کا میل اصول ملازمتوں کی میل رکھتا ہے۔"

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "پہچانا گیا"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "سیکیورٹی"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "سرور"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "سائن ان مسترد ہو گیا۔ صارف نام اور پاس ورڈ چیک کریں۔"

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "سائن ان ہو گیا، لیکن “%(folder)s” نام کا کوئی فولڈر موجود نہیں۔"

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "سائن ان ہو گیا، لیکن یہ سرور پیغامات منتقل نہیں کر سکتا۔ اس کی بجائے انہیں فلیگ کرنے کا انتخاب کریں۔"

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "سائن ان ہو گیا۔ “%(folder)s” میں %(count)d پیغام پڑھے جانے کا منتظر ہے۔"
msgstr[1] "سائن ان ہو گیا۔ “%(folder)s” میں %(count)d پیغامات پڑھے جانے کے منتظر ہیں۔"

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (پورٹ 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "ذیلی فولڈر"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "کسی رابطے کا پتہ"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "پیغام میں کمپنی کا نام"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "فولڈر “%(folder)s” کھولا نہیں جا سکا۔"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "میل باکس نے تلاش مسترد کر دی۔"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "میل باکس نے پیغامات دینے سے انکار کر دیا۔"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "میل باکس نے فولڈر تلاش کرنے سے انکار کر دیا۔"

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "پیغامات پڑھ لیے گئے لیکن فلیگ نہیں کیے جا سکے؛ اگلا دور انہیں دوبارہ پڑھے گا۔"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "پیغامات پڑھ لیے گئے لیکن “%(folder)s” میں منتقل نہیں کیے جا سکے؛ اگلا دور انہیں دوبارہ پڑھے گا۔"

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "پیغامات پڑھ لیے گئے، لیکن یہ سرور انہیں منتقل نہیں کر سکتا؛ اگلا دور انہیں دوبارہ پڑھے گا۔"

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "پیغام میں عہدے کا عنوان"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "بھیجنے والے کا ویب ڈومین"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "یہ فولڈر اپنے فلیگ نہیں رکھتا، اس لیے Postulo پڑھے ہوئے پیغامات پر فلیگ لگانے کے بجائے یہ یاد رکھتا ہے کہ پچھلا پاس کہاں رکا تھا۔"

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (پورٹ 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "صرف تب استعمال ہوتا ہے جب پیغامات منتقل کیے جائیں۔ موجود نہ ہو تو بنا دیا جاتا ہے۔"

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "صارف نام"
