#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d vēstuli nevarēja sasaistīt ar pieteikumu; pievienojiet to manuāli."
msgstr[1] "%(count)d vēstules nevarēja sasaistīt ar pieteikumu; pievienojiet tās manuāli."
msgstr[2] "%(count)d vēstuļu nevarēja sasaistīt ar pieteikumu; pievienojiet tās manuāli."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d vēstuli nevarēja nolasīt, un tā tika izlaista."
msgstr[1] "%(count)d vēstules nevarēja nolasīt, un tās tika izlaistas."
msgstr[2] "%(count)d vēstuļu nevarēja nolasīt, un tās tika izlaistas."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Vēstule bez temata"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "noraidījums"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "atbilde uz jau sasaistītu vēstuli"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "apstiprinājums"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Lietotnes parole, ja serveris tādu piedāvā; Gmail to prasa, ja ieslēgta divfaktoru autentifikācija. Glabāta šifrēti."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "novērtējums"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "ielūgums"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "piedāvājums"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Neizdevās sasniegt serveri. Pārbaudiet adresi, portu un drošības iestatījumu."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Atzīmēt ar %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "Karodziņš vairumā klientu nav redzams, un ar to katra caurskate ir īsa. Ja pastkaste netiek mainīta, caurskatē tiek lasītas tikai vēstules, kas atnākušas kopš iepriekšējās; abos gadījumos nekas netiek ieteikts divreiz."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Lasāmā mape"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Piemēram, imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "No"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Norādiet dienu skaitu no 1 līdz %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Norādiet portu no 1 līdz 65535 vai atstājiet to tukšu."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Par cik dienām pastu aplūko viena caurskate."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Atstāt pastkasti neskartu"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Ja tukšs: 993 ar TLS, 143 ar STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Atskatīšanās periods"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Pastkaste (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Atpazīts pēc"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Pārvietot uz apakšmapi"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Norādiet apakšmapi, kas nav lasāmā mape."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Norādiet lasāmo mapi. Postulo nekad nelasa iesūtni."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Norādiet apakšmapi, uz kuru pārvietot ziņas."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "vēl nekā"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Pēc izlasīšanas"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Viena mape, nekad iesūtne. Izveidojiet savā pasta serverī kārtulu, kas novieto šeit personāla atlases speciālistu vēstules; Postulo neko citu nelasa. Katra vēstule, ko tas nolasa, pēc tam tiek atzīmēta vai pārvietota neatkarīgi no tā, vai tā tika atpazīta."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Parole vai lietotnes parole"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Ports"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo nekad nelasa iesūtni. Norādiet mapi, kurā jūsu pasta kārtula novieto ar darbu saistītās vēstules."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Atpazīts"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Drošība"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Serveris"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Pierakstīšanās atteikta. Pārbaudiet lietotājvārdu un paroli."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Pierakstījās, bet mapes ar nosaukumu “%(folder)s” nav."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Pierakstījās, bet šis serveris nevar pārvietot vēstules. Tā vietā izvēlieties tās atzīmēt."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Pierakstījās. Mapē “%(folder)s” nolasīšanu gaida %(count)d vēstule."
msgstr[1] "Pierakstījās. Mapē “%(folder)s” nolasīšanu gaida %(count)d vēstules."
msgstr[2] "Pierakstījās. Mapē “%(folder)s” nolasīšanu gaida %(count)d vēstuļu."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (ports 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Apakšmape"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "kontaktpersonas adrese"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "uzņēmuma nosaukums vēstulē"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Neizdevās atvērt mapi “%(folder)s”."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Pastkaste noraidīja meklēšanu."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Pastkaste atteicās nodot vēstules."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Pastkaste atteicās meklēt mapi."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Vēstules tika nolasītas, bet tās nevarēja atzīmēt; nākamā caurskate tās nolasīs vēlreiz."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Vēstules tika nolasītas, bet tās nevarēja pārvietot uz “%(folder)s”; nākamā caurskate tās nolasīs vēlreiz."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Vēstules tika nolasītas, bet šis serveris tās nevar pārvietot; nākamā caurskate tās nolasīs vēlreiz."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "amata nosaukums vēstulē"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "sūtītāja tīmekļa domēns"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Šī mape neglabā savus karodziņus, tāpēc Postulo atceras, kur apstājās pēdējā caurskate, nevis atzīmē izlasīto ar karodziņu."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (ports 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Izmanto tikai tad, ja vēstules tiek pārvietotas. Ja tās nav, tā tiek izveidota."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Lietotājvārds"
