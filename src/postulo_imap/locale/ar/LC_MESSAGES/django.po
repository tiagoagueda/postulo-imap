#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "لم تتعذّر مطابقة أي رسالة مع طلب توظيف."
msgstr[1] "تعذّرت مطابقة رسالة واحدة مع طلب توظيف؛ اربطها يدويًا."
msgstr[2] "تعذّرت مطابقة %(count)d رسالتين مع طلب توظيف؛ اربطهما يدويًا."
msgstr[3] "تعذّرت مطابقة %(count)d رسائل مع طلب توظيف؛ اربطها يدويًا."
msgstr[4] "تعذّرت مطابقة %(count)d رسالةً مع طلب توظيف؛ اربطها يدويًا."
msgstr[5] "تعذّرت مطابقة %(count)d رسالة مع طلب توظيف؛ اربطها يدويًا."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "لم تُتخطَّ أي رسالة لتعذّر قراءتها."
msgstr[1] "تعذّرت قراءة رسالة واحدة فتم تخطيها."
msgstr[2] "تعذّرت قراءة %(count)d رسالتين فتم تخطيهما."
msgstr[3] "تعذّرت قراءة %(count)d رسائل فتم تخطيها."
msgstr[4] "تعذّرت قراءة %(count)d رسالةً فتم تخطيها."
msgstr[5] "تعذّرت قراءة %(count)d رسالة فتم تخطيها."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "رسالة بلا موضوع"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "رفض"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "ردّ على رسالة سبقت مطابقتها"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "إشعار بالاستلام"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "كلمة مرور التطبيق حيثما يوفّرها الخادم؛ ويشترطها Gmail عند تفعيل المصادقة الثنائية. تُخزَّن مشفّرة."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "تقييم"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "دعوة"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "عرض عمل"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "تعذّر الوصول إلى الخادم. تحقق من العنوان والمنفذ وإعداد الأمان."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "تعليمها بالكلمة المفتاحية %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "العلامات غير مرئية في معظم برامج البريد وتُبقي كل دورة فحص قصيرة. أما ترك صندوق البريد دون تغيير فيعني إعادة قراءة كل رسالة حديثة في كل مرة؛ ولا يُقترح أي شيء مرتين في الحالتين."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "المجلد المراد قراءته"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "مثلًا imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "المرسل"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "أدخل عددًا من الأيام بين 1 و%(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "أدخل منفذًا بين 1 و65535، أو اتركه فارغًا."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "عدد أيام البريد التي تشملها كل دورة فحص."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "ترك صندوق البريد دون تغيير"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "إن تُرك فارغًا: 993 مع TLS، و143 مع STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "الفترة المشمولة"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "صندوق البريد (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "تمت المطابقة عبر"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "نقلها إلى مجلد فرعي"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "حدّد مجلدًا فرعيًا غير المجلد الذي تُقرأ منه الرسائل."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "حدّد اسم المجلد المراد قراءته. لا يقرأ Postulo البريد الوارد أبدًا."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "حدّد اسم المجلد الفرعي الذي تُنقل إليه الرسائل."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "لا شيء بعد"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "بعد القراءة"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "مجلد واحد، وليس البريد الوارد أبدًا. أنشئ قاعدة على خادم بريدك تضع رسائل مسؤولي التوظيف في هذا المجلد؛ لا يقرأ Postulo أي شيء آخر. كل رسالة يقرؤها تُعلَّم أو تُنقل بعد ذلك، سواء تم التعرّف عليها أم لا."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "كلمة المرور أو كلمة مرور التطبيق"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "المنفذ"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "لا يقرأ Postulo البريد الوارد أبدًا. حدّد المجلد الذي تضع فيه قاعدة بريدك رسائل الوظائف."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "تم التعرّف عليه"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "الأمان"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "الخادم"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "رُفض تسجيل الدخول. تحقق من اسم المستخدم وكلمة المرور."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "تم تسجيل الدخول، لكن لا يوجد مجلد باسم «%(folder)s»."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "تم تسجيل الدخول، لكن هذا الخادم لا يستطيع نقل الرسائل. اختر تعليمها بدلًا من ذلك."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "تم تسجيل الدخول. لا توجد رسائل في «%(folder)s» بانتظار القراءة."
msgstr[1] "تم تسجيل الدخول. توجد رسالة واحدة في «%(folder)s» بانتظار القراءة."
msgstr[2] "تم تسجيل الدخول. توجد %(count)d رسالتان في «%(folder)s» بانتظار القراءة."
msgstr[3] "تم تسجيل الدخول. توجد %(count)d رسائل في «%(folder)s» بانتظار القراءة."
msgstr[4] "تم تسجيل الدخول. توجد %(count)d رسالةً في «%(folder)s» بانتظار القراءة."
msgstr[5] "تم تسجيل الدخول. توجد %(count)d رسالة في «%(folder)s» بانتظار القراءة."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (المنفذ 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "المجلد الفرعي"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "عنوان إحدى جهات الاتصال"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "اسم الشركة في الرسالة"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "تعذّر فتح المجلد «%(folder)s»."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "رفض صندوق البريد البحث."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "رفض صندوق البريد تسليم الرسائل."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "رفض صندوق البريد البحث عن المجلد."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "قُرئت الرسائل لكن تعذّر تعليمها؛ وستقرؤها دورة الفحص التالية من جديد."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "قُرئت الرسائل لكن تعذّر نقلها إلى «%(folder)s»؛ وستقرؤها دورة الفحص التالية من جديد."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "قُرئت الرسائل، لكن هذا الخادم لا يستطيع نقلها؛ وستقرؤها دورة الفحص التالية من جديد."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "المسمّى الوظيفي في الرسالة"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "نطاق الويب الخاص بالمرسل"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so every message of the look-back is read again on each pass."
msgstr "لا يحتفظ هذا المجلد بعلامات خاصة به، لذا تُعاد قراءة كل رسالة ضمن الفترة المشمولة في كل دورة فحص."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (المنفذ 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "يُستخدم فقط عند نقل الرسائل. يُنشأ إن لم يكن موجودًا."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "اسم المستخدم"
