#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d n'ha betg pudì vegnir attribuì ad ina candidatura; agiuntai el manualmain."
msgstr[1] "%(count)d n'han betg pudì vegnir attribuids ad ina candidatura; agiuntai els manualmain."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d messadi n'ha betg pudì vegnir legì ed è vegnì sursiglì."
msgstr[1] "%(count)d messadis n'han betg pudì vegnir legids ed èn vegnids sursiglids."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "In messadi senza object"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "in refus"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "ina resposta ad in messadi gia attribuì"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "ina conferma da retschavida"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "In pled-clav d'app, nua ch'il server porscha in; Gmail al pretenda cun l'autentificaziun da dus facturs activada. Memorisà criptà."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "in'evaluaziun"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "in'invitaziun"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "in'offerta"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Impussibel da cuntanscher il server. Controllai l'adressa, il port e la segirezza."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Al marcar cun %(keyword)s"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "Marcar cun in segn è nunvesaivel en la gronda part dals clients e tegna curt mintga passadi. Sch'ins lascha la chascha da posta sco ch'ella è, legia in passadi be ils messadis arrivads dapi l'ultim; en omaduas variantas na vegn nagut proponì dus giadas."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Ordinatur da leger"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Per exempel imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Da"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Indicai in dumber da dis tranter 1 e %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Indicai in port tranter 1 e 65535, u laschai il champ vid."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Quants dis dad e-mail ch'ina passada resguarda."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Laschar intacta la chascha da posta"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Laschà vid: 993 cun TLS, 143 cun STARTTLS."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Look back"
msgstr "Retrospectiva"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Chascha da posta (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Attribuì tras"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Al spustar en in sutordinatur"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Numnai in sutordinatur auter che l'ordinatur che vegn legì."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Numnai l'ordinatur da leger. Postulo na legia mai la chascha d'entrada."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Numnai il sutordinatur, en il qual ils messadis vegnan spustads."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "anc nagut"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Suenter la lectura"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "In ordinatur, mai la chascha d'entrada. Creai ina regla sin Voss server dad e-mail che metta qua l'e-mail da recrutaders; Postulo na legia nagut auter. Mintga messadi ch'el legia vegn suenter marcà u spustà, che quel saja vegnì renconuschì u betg."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Pled-clav u pled-clav d'app"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo na legia mai la chascha d'entrada. Numnai l'ordinatur, en il qual Vossa regla dad e-mail metta l'e-mail da lavur."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Renconuschì"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Segirezza"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Server"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Annunzia refusada. Controllai il num d'utilisader ed il pled-clav."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Annunzià, ma i na dat nagin ordinatur cun il num «%(folder)s»."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Annunzià, ma quest server na po betg spustar messadis. Tschernai empè da als marcar."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Annunzià. %(count)d messadi en «%(folder)s» spetga d'esser legì."
msgstr[1] "Annunzià. %(count)d messadis en «%(folder)s» spetgan d'esser legids."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Sutordinatur"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "l'adressa d'in contact"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "il num da l'interpresa en il messadi"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "L'ordinatur «%(folder)s» n'ha betg pudì vegnir avert."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "La chascha da posta ha refusà la tschertga."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "La chascha da posta ha refusà da dar ils messadis."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "La chascha da posta ha refusà da tschertgar l'ordinatur."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Ils messadis èn vegnids legids, ma n'han betg pudì vegnir marcads; la proxima passada als legia anc ina giada."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Ils messadis èn vegnids legids, ma n'han betg pudì vegnir spustads en «%(folder)s»; la proxima passada als legia anc ina giada."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Ils messadis èn vegnids legids, ma quest server n'als po betg spustar; la proxima passada als legia anc ina giada."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "il titel da la funcziun en il messadi"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "il domain web dal speditur"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Questa mappa na conserva nagins segns atgnas, perquai sa regorda Postulo nua che l'ultim passadi è sa fermà, enstagl da marcar quai ch'el ha legì."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Utilisà mo, sche messadis vegnan spustads. Creà, sch'el manca."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Num d'utilisader"
