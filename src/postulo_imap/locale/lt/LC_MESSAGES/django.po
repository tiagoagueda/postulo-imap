#: src/postulo_imap/sync.py:217
#, python-format, draft
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "%(count)d nepavyko susieti su paraiška; pridėkite juos rankiniu būdu."

#: src/postulo_imap/sync.py:190
#, draft
msgid "A message with no subject"
msgstr "Laiškas be temos"

#: src/postulo_imap/sync.py:61
#, draft
msgid ""
"An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr ""
"Programos slaptažodis, kai serveris jį siūlo; Gmail jo reikalauja, kai įjungta dviejų veiksnių autentifikacija. Saugomas užšifruotas."

#: src/postulo_imap/mailbox.py:282
msgid ""
"Could not reach the server. Check the address, the port and the security."
msgstr ""

#: src/postulo_imap/sync.py:84
#, python-format, draft
msgid "Flag it with %(keyword)s"
msgstr "Pažymėti žyme %(keyword)s"

#: src/postulo_imap/sync.py:90
#, draft
msgid ""
"Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr ""
"Žymėjimas daugumoje klientų nematomas ir kiekvieną peržiūrą daro trumpą. Paliekant pašto dėžutę nepaliestą, kiekvienas naujas laiškas skaitomas iš naujo; bet kuriuo atveju niekas nesiūloma dukart."

#: src/postulo_imap/sync.py:69
#, draft
msgid "Folder to read"
msgstr "Skaitomas aplankas"

#: src/postulo_imap/sync.py:41
#, draft
msgid "For example imap.example.org."
msgstr "Pavyzdžiui, imap.example.org."

#: src/postulo_imap/sync.py:196
#, draft
msgid "From"
msgstr "Nuo"

#: src/postulo_imap/sync.py:111
#, draft
msgid "How many days of mail a pass considers."
msgstr "Kiek dienų pašto apima viena peržiūra."

#: src/postulo_imap/sync.py:86
#, draft
msgid "Leave the mailbox untouched"
msgstr "Palikti pašto dėžutę nepaliestą"

#: src/postulo_imap/sync.py:107
