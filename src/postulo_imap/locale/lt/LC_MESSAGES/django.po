#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d laiško nepavyko susieti su paraiška; prisekite jį rankiniu būdu."
msgstr[1] "%(count)d laiškų nepavyko susieti su paraiška; prisekite juos rankiniu būdu."
msgstr[2] "%(count)d laiškų nepavyko susieti su paraiška; prisekite juos rankiniu būdu."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d laiško nepavyko perskaityti, todėl jis buvo praleistas."
msgstr[1] "%(count)d laiškų nepavyko perskaityti, todėl jie buvo praleisti."
msgstr[2] "%(count)d laiškų nepavyko perskaityti, todėl jie buvo praleisti."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Laiškas be temos"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "atsisakymas"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "atsakymas į jau susietą laišką"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "gavimo patvirtinimas"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Programos slaptažodis, jei serveris tokį siūlo; Gmail jo reikalauja, kai įjungtas patvirtinimas dviem veiksmais. Saugomas užšifruotas."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "vertinimo užduotis"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "kvietimas"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "pasiūlymas"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Nepavyko pasiekti serverio. Patikrinkite adresą, prievadą ir saugos nustatymą."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Pažymėti vėliavėle %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "Žymėjimas vėliavėle daugumoje klientų nematomas ir leidžia kiekvieną peržiūrą atlikti greitai. Palikus pašto dėžutę nepakeistą, peržiūros metu skaitomi tik nuo ankstesnės peržiūros gauti laiškai; abiem atvejais niekas nesiūlomas du kartus."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Nuskaitomas aplankas"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Pavyzdžiui, imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Siuntėjas"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Nurodykite dienų skaičių nuo 1 iki %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Nurodykite prievadą nuo 1 iki 65535 arba palikite tuščią."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Kiek dienų laiškų apima vienas nuskaitymas."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Palikti pašto dėžutę nepakeistą"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Palikus tuščią: 993 su TLS, 143 su STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Kiek dienų atgal"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Pašto dėžutė (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Susieta pagal"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Perkelti į poaplankį"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Nurodykite kitą poaplankį nei skaitomas aplankas."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Nurodykite, kurį aplanką nuskaityti. Postulo niekada neskaito gautų laiškų aplanko."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Nurodykite poaplankį, į kurį perkelti laiškus."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "kol kas nieko"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Nuskaičius"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Vienas aplankas, niekada ne gautieji. Pašto serveryje sukurkite taisyklę, kuri darbuotojų atrankos specialistų laiškus perkeltų čia; nieko kito Postulo neskaito. Kiekvienas perskaitytas laiškas po to pažymimas arba perkeliamas, nesvarbu, ar jis buvo atpažintas, ar ne."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Slaptažodis arba programos slaptažodis"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Prievadas"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo niekada neskaito gautųjų laiškų aplanko. Nurodykite aplanką, į kurį jūsų pašto taisyklė perkelia darbo paieškos laiškus."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Atpažinta"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Sauga"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Serveris"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Prisijungti neleista. Patikrinkite naudotojo vardą ir slaptažodį."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Prisijungta, bet aplanko „%(folder)s“ nėra."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Prisijungta, tačiau šis serveris negali perkelti laiškų. Verčiau pasirinkite juos pažymėti."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Prisijungta. Aplanke „%(folder)s“ %(count)d laiškas laukia, kol bus perskaitytas."
msgstr[1] "Prisijungta. Aplanke „%(folder)s“ %(count)d laiškai laukia, kol bus perskaityti."
msgstr[2] "Prisijungta. Aplanke „%(folder)s“ %(count)d laiškų laukia, kol bus perskaityti."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (prievadas 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Poaplankis"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "kontaktinio asmens adresas"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "įmonės pavadinimas laiške"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Nepavyko atverti aplanko „%(folder)s“."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Pašto dėžutė atmetė paieškos užklausą."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Pašto dėžutė atsisakė perduoti laiškus."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Pašto dėžutė atsisakė ieškoti aplanko."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Laiškai perskaityti, bet jų nepavyko pažymėti; kito tikrinimo metu jie bus perskaityti iš naujo."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Laiškai perskaityti, bet jų nepavyko perkelti į „%(folder)s“; kito tikrinimo metu jie bus perskaityti iš naujo."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Laiškai perskaityti, bet šis serveris negali jų perkelti; kito tikrinimo metu jie bus perskaityti iš naujo."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "pareigų pavadinimas laiške"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "siuntėjo žiniatinklio domenas"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Šis aplankas nesaugo savų vėliavėlių, todėl Postulo prisimena, kur sustojo paskutinė peržiūra, užuot pažymėjusi perskaitytus laiškus vėliavėle."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (prievadas 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Naudojamas tik perkeliant laiškus. Sukuriamas, jei jo nėra."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Naudotojo vardas"
