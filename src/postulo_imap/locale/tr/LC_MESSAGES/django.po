#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d ileti bir başvuruyla eşleştirilemedi; elle bağlayın."
msgstr[1] "%(count)d ileti bir başvuruyla eşleştirilemedi; elle bağlayın."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d ileti okunamadı ve atlandı."
msgstr[1] "%(count)d ileti okunamadı ve atlandı."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Konusu olmayan bir ileti"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "bir ret"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "zaten eşleştirilmiş bir iletiye yanıt"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "bir alındı bildirimi"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Sunucu sunuyorsa bir uygulama parolası; Gmail, iki faktörlü kimlik doğrulama açıkken bunu zorunlu tutar. Şifrelenmiş olarak saklanır."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "bir değerlendirme"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "bir davet"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "bir teklif"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Sunucuya ulaşılamadı. Adresi, bağlantı noktasını ve güvenlik ayarını kontrol edin."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "%(keyword)s ile işaretle"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "İşaretleme çoğu istemcide görünmez ve her geçişi kısa tutar. Posta kutusuna dokunulmadığında bir geçiş yalnızca bir öncekinden sonra gelen iletileri okur; her iki durumda da hiçbir şey iki kez önerilmez."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Okunacak klasör"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Örneğin imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Gönderen"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "1 ile %(max)d arasında bir gün sayısı girin."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "1 ile 65535 arasında bir bağlantı noktası girin ya da boş bırakın."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Bir geçişin kaç günlük postaya baktığı."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Posta kutusuna dokunma"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Boş bırakılırsa: TLS ile 993, STARTTLS ile 143."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Geriye bakış süresi"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Posta kutusu (IMAP)"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Matched by"
msgstr "Eşleşme ölçütü"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Bir alt klasöre taşı"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Okunan klasörden farklı bir alt klasör adı girin."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Okunacak klasörün adını girin. Postulo gelen kutusunu asla okumaz."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "İletilerin taşınacağı alt klasörün adını girin."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "henüz hiçbir şey yok"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Okunduktan sonra"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Tek bir klasör, asla gelen kutusu değil. Posta sunucunuzda işe alım uzmanlarından gelen postaları buraya dosyalayan bir kural oluşturun; Postulo başka hiçbir şeyi okumaz. Okuduğu her ileti, tanınsın ya da tanınmasın, ardından işaretlenir ya da taşınır."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Parola ya da uygulama parolası"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Bağlantı noktası"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo gelen kutusunu asla okumaz. Posta kuralınızın iş postalarını dosyaladığı klasörün adını girin."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Tanınan"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Güvenlik"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Sunucu"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Giriş reddedildi. Kullanıcı adını ve parolayı kontrol edin."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Giriş yapıldı, ancak “%(folder)s” adında bir klasör yok."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Giriş yapıldı, ancak bu sunucu iletileri taşıyamıyor. Bunun yerine işaretlemeyi seçin."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Giriş yapıldı. “%(folder)s” klasöründe okunmayı bekleyen %(count)d ileti var."
msgstr[1] "Giriş yapıldı. “%(folder)s” klasöründe okunmayı bekleyen %(count)d ileti var."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (bağlantı noktası 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Alt klasör"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "bir kişinin adresi"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "iletideki şirket adı"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "“%(folder)s” klasörü açılamadı."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Posta kutusu aramayı reddetti."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Posta kutusu iletileri vermeyi reddetti."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Posta kutusu klasörü aramayı reddetti."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "İletiler okundu ama işaretlenemedi; bir sonraki geçişte yeniden okunacaklar."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "İletiler okundu ancak “%(folder)s” klasörüne taşınamadı; bir sonraki geçişte yeniden okunacaklar."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "İletiler okundu, ancak bu sunucu onları taşıyamıyor; bir sonraki geçişte yeniden okunacaklar."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "iletideki pozisyon adı"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "gönderenin web alan adı"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Bu klasör kendi işaretlerini tutmaz, bu yüzden Postulo okuduklarını işaretlemek yerine son geçişin nerede durduğunu hatırlar."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (bağlantı noktası 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Yalnızca iletiler taşındığında kullanılır. Yoksa oluşturulur."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Kullanıcı adı"
