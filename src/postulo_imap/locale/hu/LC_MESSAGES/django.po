#: src/postulo_imap/sync.py:221
#, python-format, draft
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "%(count)d nem volt párosítható jelentkezéshez; csatold őket kézzel."

#: src/postulo_imap/sync.py:194
#, draft
msgid "A message with no subject"
msgstr "Tárgy nélküli üzenet"

#: src/postulo_imap/sync.py:65
#, draft
msgid ""
"An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr ""
"Alkalmazásjelszó, ahol a szerver kínál ilyet; a Gmail bekapcsolt kétlépcsős hitelesítés mellett megköveteli. Titkosítva tárolva."

#: src/postulo_imap/mailbox.py:282
msgid ""
"Could not reach the server. Check the address, the port and the security."
msgstr ""

#: src/postulo_imap/sync.py:88
#, python-format, draft
msgid "Flag it with %(keyword)s"
msgstr "Megjelölés ezzel: %(keyword)s"

#: src/postulo_imap/sync.py:94
#, draft
msgid ""
"Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr ""
"A megjelölés a legtöbb levelezőben láthatatlan, és minden menet rövid marad. Ha a postafiók érintetlen marad, minden friss üzenet újra beolvasásra kerül; egyik esetben sem javasol semmit kétszer."

#: src/postulo_imap/sync.py:73
#, draft
msgid "Folder to read"
msgstr "Olvasandó mappa"

#: src/postulo_imap/sync.py:45
#, draft
msgid "For example imap.example.org."
msgstr "Például imap.example.org."

#: src/postulo_imap/sync.py:200
#, draft
msgid "From"
msgstr "Feladó"

#: src/postulo_imap/sync.py:115
#, draft
msgid "How many days of mail a pass considers."
msgstr "Hány napnyi levelet vesz figyelembe egy menet."

#: src/postulo_imap/sync.py:90
#, draft
msgid "Leave the mailbox untouched"
msgstr "A postafiók maradjon érintetlen"

#: src/postulo_imap/sync.py:111
#, draft
msgid "Look back"
msgstr "Visszatekintés"

#: src/postulo_imap/sync.py:40
#, draft
msgid "Mailbox (IMAP)"
msgstr "Postafiók (IMAP)"

#: src/postulo_imap/sync.py:201
#, draft
msgid "Matched by"
msgstr "Párosítás alapja"

#: src/postulo_imap/sync.py:89
#, draft
msgid "Move it to a subfolder"
msgstr "Áthelyezés almappába"

#: src/postulo_imap/sync.py:128
#, draft
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr ""
"Add meg az olvasandó mappát. A Postulo soha nem olvassa a beérkezett üzeneteket."

#: src/postulo_imap/sync.py:126
#, draft
msgid "Name the subfolder to move messages to."
msgstr "Add meg az almappát, ahová az üzenetek kerülnek."

#: src/postulo_imap/sync.py:201
#, draft
msgid "nothing yet"
msgstr "még semmi"

#: src/postulo_imap/sync.py:85
#, draft
msgid "Once read"
msgstr "Olvasás után"

#: src/postulo_imap/sync.py:77
#, draft
msgid ""
"One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else."
msgstr ""
"Egyetlen mappa, soha nem a beérkezett üzenetek. Készíts egy szabályt a levelezőszervereden, amely ide teszi a toborzói leveleket; a Postulo mást nem olvas."

#: src/postulo_imap/sync.py:61
#, draft
msgid "Password or app password"
msgstr "Jelszó vagy alkalmazásjelszó"

#: src/postulo_imap/sync.py:47
#, draft
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py:203
#, draft
msgid "Recognised"
msgstr "Felismerve"

#: src/postulo_imap/sync.py:50
#, draft
msgid "Security"
msgstr "Biztonság"

#: src/postulo_imap/sync.py:45
#, draft
msgid "Server"
msgstr "Szerver"

#: src/postulo_imap/mailbox.py:290
msgid "Sign-in refused. Check the username and the password."
msgstr ""

#: src/postulo_imap/sync.py:143
#, python-format, draft
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Bejelentkezve, de nincs „%(folder)s” nevű mappa."

#: src/postulo_imap/sync.py:158
#, python-format, draft
msgid "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr ""
"Bejelentkezve. %(count)d üzenet vár olvasásra a(z) „%(folder)s” mappában."

#: src/postulo_imap/sync.py:54
#, draft
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (143-as port)"

#: src/postulo_imap/sync.py:103
#, draft
msgid "Subfolder"
msgstr "Almappa"

