#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d nem lehet illeszkedni egy kérelemhez; csatolja azt kézzel."
msgstr[1] "%(count)d nem lehet illeszkedni egy kérelemhez; csatolja azokat kézzel."

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d üzenet nem lehetett olvasni, és kimaradt."
msgstr[1] "%(count)d üzenetek nem lehetett olvasni, és kimaradt."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Tárgy nélküli üzenet"

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "a rejection"
msgstr "kilökődés"

#: src/postulo_imap/matching.py
#, fuzzy
msgid "a reply to a message already matched"
msgstr "a már egyeztetett üzenetre adott válasz"

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an acknowledgement"
msgstr "visszaigazolás"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Alkalmazásjelszó, ahol a kiszolgáló kínál ilyet; a Gmail bekapcsolt kétlépcsős azonosítás mellett megköveteli. Titkosítva tárolva."

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an assessment"
msgstr "értékelés"

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an invitation"
msgstr "meghívó"

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an offer"
msgstr "ajánlat"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Nem sikerült elérni a kiszolgálót. Ellenőrizze a címet, a portot és a biztonsági beállítást."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Megjelölés ezzel: %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "A megjelölés a legtöbb levelezőprogramban nem látszik, és minden menetet rövidre fog. Ha a postafiókot érintetlenül hagyja, minden friss üzenet újra beolvasásra kerül; a Postulo egyik esetben sem javasol semmit kétszer."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Olvasandó mappa"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Például imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Ettől"

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Adjon meg néhány napot 1 és %(max)d között."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Adjon egy portot 1 és 65535 között, vagy hagyja üresen."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Hány napnyi levelet vesz figyelembe egy menet."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "A postafiók maradjon érintetlen"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Üres maradt: 993 TLS, 143 STARTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Visszatekintés"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Postafiók (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Párosítás alapja"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Áthelyezés almappába"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Name a subfolder other than the folder being read."
msgstr "Nevezz meg egy alkönyvtárat, amely nem az olvasott mappát tartalmazza."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Adja meg az olvasandó mappát. A Postulo soha nem olvassa a beérkezett üzeneteket."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Adja meg az almappát, ahová az üzenetek kerüljenek."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "még semmi"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Olvasás után"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Egy mappa, sosem a postaláda. Készíts egy szabályt a mail szervereden, hogy fájlokat toborzó mail itt; Postulo semmi mást nem olvas. Minden üzenetet, amit olvas, megjelölnek, vagy továbbítanak, akár felismerték, akár nem."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Jelszó vagy alkalmazásjelszó"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo soha nem olvassa a postaládát. Nevezze meg a mappát a mail szabály fájlok munka mail."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Felismerve"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Biztonság"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Kiszolgáló"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "A bejelentkezés elutasítva. Ellenőrizze a felhasználónevet és a jelszót."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Bejelentkezve, de nincs „%(folder)s” nevű mappa."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Bejelentkezett, de ez a szerver nem tud üzeneteket mozgatni. Inkább jelölje meg őket."

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Aláírás: %(count)d üzenet a \"%(folder)s\" -ban, arra vár, hogy elolvassák."
msgstr[1] "%(count)d üzenetek a \"%(folder)s\" -ban várják az olvasást."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (143-as port)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Almappa"

#: src/postulo_imap/matching.py
#, fuzzy
msgid "the address of a contact"
msgstr "a kapcsolattartó címe"

#: src/postulo_imap/matching.py
#, fuzzy
msgid "the company’s name in the message"
msgstr "a vállalat neve az üzenetben"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Nem sikerült megnyitni a(z) „%(folder)s” mappát."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "A postafiók elutasította a keresést."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "A postafiók nem adta át az üzeneteket."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "The mailbox refused to look for the folder."
msgstr "A postaláda nem kereste a mappát."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Az üzeneteket elolvasták, de nem lehetett megjelölni; a következő hágó újra el fogja olvasni őket."

#: src/postulo_imap/mailbox.py
#, fuzzy, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Az üzeneteket elolvasták, de nem lehetett áthelyezni \"%(folder)s\" -ra; a következő passz újra el fogja olvasni őket."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Az üzeneteket elolvasták, de ez a kiszolgáló nem tudja mozgatni őket; a következő hágó újra el fogja olvasni őket."

#: src/postulo_imap/matching.py
#, fuzzy
msgid "the role’s title in the message"
msgstr "az üzenet címe"

#: src/postulo_imap/matching.py
#, fuzzy
msgid "the sender’s web domain"
msgstr "a feladó web domain"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "This folder does not keep flags of its own, so every message of the look-back is read again on each pass."
msgstr "Ez a mappa nem tartja meg a saját lobogóit, így a visszapillantó minden üzenetét újra olvassuk minden egyes hágón."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (993-as port)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Csak az üzenetek áthelyezésekor használatos. Ha nem létezik, létrejön."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Felhasználónév"
