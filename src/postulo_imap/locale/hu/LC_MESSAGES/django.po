#, draft
msgid "TLS (port 993)"
msgstr "TLS (993-as port)"

#: src/postulo_imap/sync.py:107
#, draft
msgid "Used only when messages are moved. Created if missing."
msgstr "Csak az üzenetek áthelyezésekor használt. Létrejön, ha hiányzik."

