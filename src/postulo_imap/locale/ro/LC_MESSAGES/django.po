#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d mesaj nu a putut fi asociat cu o candidatură; atașați-l manual."
msgstr[1] "%(count)d mesaje nu au putut fi asociate cu o candidatură; atașați-le manual."
msgstr[2] "%(count)d de mesaje nu au putut fi asociate cu o candidatură; atașați-le manual."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d mesaj nu a putut fi citit și a fost omis."
msgstr[1] "%(count)d mesaje nu au putut fi citite și au fost omise."
msgstr[2] "%(count)d de mesaje nu au putut fi citite și au fost omise."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Un mesaj fără subiect"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "o respingere"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "un răspuns la un mesaj deja asociat"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "o confirmare"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "O parolă de aplicație oriunde serverul oferă una; Gmail o cere când autentificarea în doi pași este activată. Stocată criptat."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "o evaluare"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "o invitație"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "o ofertă"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Serverul nu a putut fi contactat. Verificați adresa, portul și securitatea."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Marcați-l cu %(keyword)s"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "Marcarea cu indicator este invizibilă în majoritatea clienților și păstrează fiecare parcurgere scurtă. Dacă lăsați căsuța neatinsă, o parcurgere citește doar mesajele sosite de la ultima; în ambele cazuri nimic nu este sugerat de două ori."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Dosarul de citit"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "De exemplu imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "De la"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Introduceți un număr de zile între 1 și %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Introduceți un port între 1 și 65535 sau lăsați câmpul gol."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Câte zile de e-mail ia în considerare o rulare."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Lăsați căsuța poștală neatinsă"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Dacă este gol: 993 cu TLS, 143 cu STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Perioadă analizată"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Căsuță poștală (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Recunoscut după"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Mutați-l într-un subdosar"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Indicați un subdosar diferit de dosarul citit."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Indicați dosarul de citit. Postulo nu citește niciodată Inboxul."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Indicați subdosarul în care să fie mutate mesajele."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "nimic încă"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "După citire"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Un singur dosar, niciodată Inboxul. Creați pe serverul de e-mail o regulă care mută aici e-mailurile de la recrutori; Postulo nu citește nimic altceva. Fiecare mesaj citit este apoi marcat sau mutat, fie că a fost recunoscut, fie că nu."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Parolă sau parolă de aplicație"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo nu citește niciodată Inboxul. Indicați dosarul în care regula dumneavoastră de e-mail mută mesajele despre joburi."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Recunoscute"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Securitate"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Server"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Conectare refuzată. Verificați numele de utilizator și parola."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Conectat, dar nu există niciun dosar numit „%(folder)s”."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Conectat, dar acest server nu poate muta mesaje. Alegeți în schimb marcarea lor."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Conectat. %(count)d mesaj din „%(folder)s” așteaptă să fie citit."
msgstr[1] "Conectat. %(count)d mesaje din „%(folder)s” așteaptă să fie citite."
msgstr[2] "Conectat. %(count)d de mesaje din „%(folder)s” așteaptă să fie citite."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Subdosar"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "adresa unui contact"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "numele companiei din mesaj"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Dosarul „%(folder)s” nu a putut fi deschis."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Căsuța poștală a refuzat căutarea."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Căsuța poștală a refuzat să transmită mesajele."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Căsuța poștală a refuzat să caute dosarul."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Mesajele au fost citite, dar nu au putut fi marcate; următoarea rulare le va citi din nou."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Mesajele au fost citite, dar nu au putut fi mutate în „%(folder)s”; următoarea rulare le va citi din nou."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Mesajele au fost citite, dar acest server nu le poate muta; următoarea rulare le va citi din nou."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "denumirea postului din mesaj"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "domeniul web al expeditorului"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Acest dosar nu păstrează indicatori proprii, așa că Postulo își amintește unde s-a oprit ultima parcurgere, în loc să marcheze ce a citit."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Folosit doar când mesajele sunt mutate. Creat dacă lipsește."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Nume de utilizator"
