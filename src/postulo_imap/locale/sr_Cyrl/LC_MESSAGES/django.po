#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d порука није могла да се повеже ни са једном пријавом; приложите је ручно."
msgstr[1] "%(count)d поруке нису могле да се повежу ни са једном пријавом; приложите их ручно."
msgstr[2] "%(count)d порука није могло да се повеже ни са једном пријавом; приложите их ручно."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d порука није могла да се прочита и прескочена је."
msgstr[1] "%(count)d поруке нису могле да се прочитају и прескочене су."
msgstr[2] "%(count)d порука није могло да се прочита и прескочено је."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Порука без предмета"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "одбијање"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "одговор на већ упарену поруку"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "потврда пријема"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Лозинка за апликацију, где год је сервер нуди; Gmail је захтева када је укључена двофакторска потврда идентитета. Чува се шифровано."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "процена"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "позив"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "понуда"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Сервер није доступан. Проверите адресу, порт и безбедност."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Означи поруку са %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "Означавање заставицом није видљиво у већини клијената и скраћује сваки пролаз. Ако се сандуче остави нетакнуто, пролаз чита само поруке које су стигле од претходног; у оба случаја ништа се не предлаже двапут."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Фасцикла за читање"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "На пример imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Од"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Унесите број дана између 1 и %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Унесите порт између 1 и 65535 или оставите празно."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Колико дана поште један пролаз узима у обзир."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Не дирај поштанско сандуче"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Ако остане празно: 993 са TLS-ом, 143 са STARTTLS-ом."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Период уназад"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Поштанско сандуче (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Упарено према"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Премести поруку у подфасциклу"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Наведите подфасциклу различиту од фасцикле која се чита."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Наведите фасциклу за читање. Postulo никада не чита пријемно сандуче."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Наведите подфасциклу у коју се премештају поруке."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "још ништа"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Након читања"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Једна фасцикла, никада пријемно сандуче. Направите правило на свом серверу поште које поруке регрутера смешта овде; Postulo не чита ништа друго. Свака порука коју прочита након тога се означава заставицом или премешта, било да је препозната или не."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Лозинка или лозинка за апликацију"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Порт"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo никада не чита пријемно сандуче. Наведите фасциклу у коју ваше правило за пошту смешта поруке о пословима."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Препознато"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Безбедност"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Сервер"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Пријављивање је одбијено. Проверите корисничко име и лозинку."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Пријављивање је успело, али не постоји фасцикла „%(folder)s“."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Пријављивање је успело, али овај сервер не може да премешта поруке. Изаберите да се уместо тога означавају заставицом."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Пријављивање је успело. %(count)d порука у „%(folder)s“ чека на читање."
msgstr[1] "Пријављивање је успело. %(count)d поруке у „%(folder)s“ чекају на читање."
msgstr[2] "Пријављивање је успело. %(count)d порука у „%(folder)s“ чека на читање."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (порт 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Подфасцикла"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "адреса контакта"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "назив компаније у поруци"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Фасцикла „%(folder)s“ није могла да се отвори."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Поштанско сандуче је одбило претрагу."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Поштанско сандуче је одбило да преда поруке."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Поштанско сандуче је одбило да потражи фасциклу."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Поруке су прочитане, али нису могле да се означе заставицом; при следећем проласку биће поново прочитане."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Поруке су прочитане, али нису могле да се преместе у „%(folder)s“; при следећем проласку биће поново прочитане."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Поруке су прочитане, али овај сервер не може да их премести; при следећем проласку биће поново прочитане."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "назив радног места у поруци"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "веб-домен пошиљаоца"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Ова фасцикла не чува сопствене заставице, па Postulo уместо означавања прочитаног памти докле је стигао последњи пролаз."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (порт 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Користи се само када се поруке премештају. Прави се ако не постоји."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Корисничко име"
