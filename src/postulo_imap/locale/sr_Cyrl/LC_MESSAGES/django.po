#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "Поруке које нису могле да се упаре са пријавом: %(count)d; повежите их ручно."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "A message with no subject"
msgstr "Порука без предмета"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Лозинка за апликацију, где год је сервер нуди; Gmail је захтева када је укључена двофакторска потврда идентитета. Чува се шифровано."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Сервер није доступан. Проверите адресу, порт и безбедност."

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Flag it with %(keyword)s"
msgstr "Означи поруку са %(keyword)s"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Означавање је невидљиво у већини клијената и сваки пролаз чини кратким. Ако се поштанско сандуче не дира, свака скорашња порука се поново чита; ни на један начин ништа се не предлаже двапут."

