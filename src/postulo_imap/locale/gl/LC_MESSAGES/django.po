#, fuzzy
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Este servidor non pode mover mensaxes. Por favor, escolla a bandeira."

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "O son da banda baséase no [[Rock latino]], [[Musica latina|ritmos latinos]], [[pop latino]] e o [[rock en español]].<ref>WEB Nun principio recibieron o éxito comercial internacional en [[México]], [[Australia]] e [[España]], e dende aquela teñen gañado popularidade e a exposición en toda [[América Latina]], [[Estados Unidos]], [[Europa]] Occidental, [[Asia]] e Oriente Medio."
msgstr[1] "O son da banda baséase no [[Rock latino]], [[Musica latina|ritmos latinos]], [[pop latino]] e o [[rock en español]].<ref>WEB Nun principio recibieron o éxito comercial internacional en [[México]]."

