#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d non se puido asociar a ningunha candidatura; anéxaa a man."
msgstr[1] "%(count)d non se puideron asociar a ningunha candidatura; anéxaas a man."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d mensaxe non se puido ler e omitiuse."
msgstr[1] "%(count)d mensaxes non se puideron ler e omitíronse."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Unha mensaxe sen asunto"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "un rexeitamento"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "unha resposta a unha mensaxe xa asociada"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "un acuse de recibo"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Un contrasinal de aplicación sempre que o servidor o ofreza; Gmail esíxeo coa verificación en dous pasos activada. Almacénase cifrado."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "unha avaliación"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "unha invitación"

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an offer"
msgstr "unha proposta de contratación"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Non se puido chegar ao servidor. Comproba o enderezo, o porto e a seguranza."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Marcala con %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Marcar non se ve na maioría dos clientes e fai que cada pasada sexa curta. Deixar intacta a caixa de correo significa que se volven ler todas as mensaxes recentes; de calquera xeito, nada se suxire dúas veces."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Cartafol que ler"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Por exemplo, imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Remitente"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Indica un número de días entre 1 e %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Indica un porto entre 1 e 65535, ou déixao baleiro."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Cantos días de correo ten en conta cada pasada."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Deixar intacta a caixa de correo"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Se se deixa baleiro: 993 con TLS, 143 con STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Mirar atrás"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Caixa de correo (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Asociada por"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Movela a un subcartafol"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Indica un subcartafol distinto do cartafol que se le."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Indica o cartafol que ler. O Postulo nunca le a caixa de entrada."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Indica o subcartafol ao que mover as mensaxes."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "aínda nada"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Unha vez lida"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Un cartafol, nunca a caixa de entrada. Crea unha regra no teu servidor de correo que arquive aquí o correo dos recrutadores; o Postulo non le nada máis. Cada mensaxe que le márcase ou móvese despois, fose recoñecida ou non."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Contrasinal ou contrasinal de aplicación"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Porto"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "O Postulo nunca le a caixa de entrada. Indica o cartafol no que a túa regra de correo arquiva o correo de emprego."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Recoñecida"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Seguranza"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Servidor"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Inicio de sesión rexeitado. Comproba o nome de usuario e o contrasinal."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Sesión iniciada, pero non hai ningún cartafol chamado «%(folder)s»."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Sesión iniciada, pero este servidor non pode mover mensaxes. Escolle marcalas no seu lugar."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Sesión iniciada. Hai %(count)d mensaxe en «%(folder)s» á espera de ser lida."
msgstr[1] "Sesión iniciada. Hai %(count)d mensaxes en «%(folder)s» á espera de ser lidas."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (porto 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Subcartafol"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "o enderezo dun contacto"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "o nome da empresa na mensaxe"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Non se puido abrir o cartafol «%(folder)s»."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "A caixa de correo rexeitou a busca."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "A caixa de correo negouse a entregar as mensaxes."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "A caixa de correo negouse a buscar o cartafol."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "As mensaxes léronse, pero non se puideron marcar; a próxima pasada volverá lelas."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "As mensaxes léronse, pero non se puideron mover a «%(folder)s»; a próxima pasada volverá lelas."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "As mensaxes léronse, pero este servidor non pode movelas; a próxima pasada volverá lelas."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "o título do posto na mensaxe"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "o dominio web do remitente"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so every message of the look-back is read again on each pass."
msgstr "Este cartafol non garda marcas propias, así que en cada pasada vólvense ler todas as mensaxes do período que se revisa."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (porto 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Só se usa cando se moven as mensaxes. Créase se non existe."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Nome de usuario"
