#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "Nie udało się dopasować %(count)d wiadomość do żadnej aplikacji; dołącz ją ręcznie."
msgstr[1] "Nie udało się dopasować %(count)d wiadomości do żadnej aplikacji; dołącz je ręcznie."
msgstr[2] "Nie udało się dopasować %(count)d wiadomości do żadnej aplikacji; dołącz je ręcznie."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d wiadomość była nieczytelna i została pominięta."
msgstr[1] "%(count)d wiadomości były nieczytelne i zostały pominięte."
msgstr[2] "%(count)d wiadomości było nieczytelnych i zostało pominiętych."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Wiadomość bez tematu"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "odrzucenie"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "odpowiedź na wiadomość już dopasowaną"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "potwierdzenie"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Hasło aplikacji wszędzie tam, gdzie serwer je oferuje; Gmail wymaga go przy włączonym uwierzytelnianiu dwuskładnikowym. Przechowywane w postaci zaszyfrowanej."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "ocena"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "zaproszenie"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "oferta"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Nie udało się połączyć z serwerem. Sprawdź adres, port i zabezpieczenia."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Oznacz flagą %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "Oznaczanie flagami jest niewidoczne w większości klientów i skraca każdy przebieg. Pozostawienie skrzynki nietkniętej oznacza, że przebieg odczytuje tylko wiadomości, które nadeszły od poprzedniego; w obu przypadkach nic nie jest proponowane dwa razy."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Folder do odczytu"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Na przykład imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Od"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Podaj liczbę dni od 1 do %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Podaj port od 1 do 65535 albo zostaw puste."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Ile dni poczty uwzględnia jeden przebieg."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Pozostaw skrzynkę bez zmian"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Puste: 993 dla TLS, 143 dla STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Zakres wstecz"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Skrzynka pocztowa (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Dopasowano według"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Przenieś do podfolderu"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Podaj podfolder inny niż odczytywany folder."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Podaj folder do odczytu. Postulo nigdy nie czyta skrzynki odbiorczej."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Podaj podfolder, do którego przenosić wiadomości."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "jeszcze nic"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Po odczytaniu"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Jeden folder, nigdy skrzynka odbiorcza. Utwórz na swoim serwerze poczty regułę, która przenosi tu wiadomości od rekruterów; Postulo nie czyta niczego innego. Każda odczytana wiadomość jest potem oznaczana flagą lub przenoszona, niezależnie od tego, czy została rozpoznana."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Hasło lub hasło aplikacji"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo nigdy nie czyta skrzynki odbiorczej. Podaj folder, do którego Twoja reguła poczty przenosi wiadomości dotyczące pracy."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Rozpoznano"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Zabezpieczenia"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Serwer"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Odmowa logowania. Sprawdź nazwę użytkownika i hasło."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Zalogowano, ale nie ma folderu o nazwie „%(folder)s”."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Zalogowano, ale ten serwer nie potrafi przenosić wiadomości. Zamiast tego wybierz oznaczanie flagą."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Zalogowano. W folderze „%(folder)s” %(count)d wiadomość czeka na odczyt."
msgstr[1] "Zalogowano. W folderze „%(folder)s” %(count)d wiadomości czekają na odczyt."
msgstr[2] "Zalogowano. W folderze „%(folder)s” %(count)d wiadomości czeka na odczyt."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Podfolder"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "adres kontaktu"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "nazwa firmy w wiadomości"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Nie można otworzyć folderu „%(folder)s”."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Skrzynka pocztowa odrzuciła wyszukiwanie."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Skrzynka pocztowa odmówiła przekazania wiadomości."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Skrzynka pocztowa odmówiła wyszukania folderu."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Wiadomości zostały odczytane, ale nie udało się oznaczyć ich flagą; następny przebieg odczyta je ponownie."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Wiadomości zostały odczytane, ale nie udało się przenieść ich do „%(folder)s”; następny przebieg odczyta je ponownie."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Wiadomości zostały odczytane, ale ten serwer nie potrafi ich przenosić; następny przebieg odczyta je ponownie."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "nazwa stanowiska w wiadomości"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "domena internetowa nadawcy"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Ten folder nie przechowuje własnych flag, więc Postulo zapamiętuje, gdzie zakończył się ostatni przebieg, zamiast oznaczać flagami to, co odczytano."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Używany tylko wtedy, gdy wiadomości są przenoszone. Tworzony, jeśli go brakuje."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Nazwa użytkownika"
