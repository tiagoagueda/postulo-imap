#: src/postulo_imap/sync.py:221
#, python-format, draft
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "%(count)d nie udało się dopasować do aplikacji; załącz je ręcznie."

#: src/postulo_imap/sync.py:194
#, draft
msgid "A message with no subject"
msgstr "Wiadomość bez tematu"

#: src/postulo_imap/sync.py:65
#, draft
msgid ""
"An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr ""
"Hasło aplikacji wszędzie tam, gdzie serwer je oferuje; Gmail wymaga go przy włączonym uwierzytelnianiu dwuskładnikowym. Przechowywane w postaci zaszyfrowanej."

#: src/postulo_imap/mailbox.py:282
msgid ""
"Could not reach the server. Check the address, the port and the security."
msgstr ""

#: src/postulo_imap/sync.py:88
#, python-format, draft
msgid "Flag it with %(keyword)s"
msgstr "Oznacz flagą %(keyword)s"

#: src/postulo_imap/sync.py:94
#, draft
msgid ""
"Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr ""
"Flagowanie jest niewidoczne w większości klientów i sprawia, że każdy przebieg jest krótki. Pozostawienie skrzynki nietkniętej oznacza, że każda niedawna wiadomość jest czytana ponownie; tak czy inaczej nic nie jest sugerowane dwa razy."

#: src/postulo_imap/sync.py:73
#, draft
msgid "Folder to read"
msgstr "Folder do odczytu"

#: src/postulo_imap/sync.py:45
#, draft
msgid "For example imap.example.org."
msgstr "Na przykład imap.example.org."

#: src/postulo_imap/sync.py:200
#, draft
msgid "From"
msgstr "Od"

#: src/postulo_imap/sync.py:115
#, draft
msgid "How many days of mail a pass considers."
msgstr "Ile dni poczty uwzględnia jeden przebieg."

#: src/postulo_imap/sync.py:90
#, draft
msgid "Leave the mailbox untouched"
msgstr "Pozostaw skrzynkę nietkniętą"

#: src/postulo_imap/sync.py:111
#, draft
msgid "Look back"
msgstr "Zakres wstecz"

#: src/postulo_imap/sync.py:40
#, draft
msgid "Mailbox (IMAP)"
msgstr "Skrzynka (IMAP)"

#: src/postulo_imap/sync.py:201
#, draft
msgid "Matched by"
msgstr "Dopasowano według"

#: src/postulo_imap/sync.py:89
#, draft
msgid "Move it to a subfolder"
msgstr "Przenieś do podfolderu"

#: src/postulo_imap/sync.py:128
#, draft
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Podaj folder do odczytu. Postulo nigdy nie czyta skrzynki odbiorczej."

#: src/postulo_imap/sync.py:126
#, draft
msgid "Name the subfolder to move messages to."
msgstr "Podaj podfolder, do którego przenosić wiadomości."

#: src/postulo_imap/sync.py:201
#, draft
msgid "nothing yet"
msgstr "jeszcze nic"

#: src/postulo_imap/sync.py:85
#, draft
msgid "Once read"
msgstr "Po odczytaniu"

#: src/postulo_imap/sync.py:77
#, draft
msgid ""
"One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else."
msgstr ""
"Jeden folder, nigdy skrzynka odbiorcza. Utwórz na swoim serwerze pocztowym regułę, która umieszcza tu pocztę od rekruterów; Postulo nie czyta niczego innego."

#: src/postulo_imap/sync.py:61
#, draft
msgid "Password or app password"
msgstr "Hasło lub hasło aplikacji"

#: src/postulo_imap/sync.py:47
#, draft
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py:203
#, draft
msgid "Recognised"
msgstr "Rozpoznano"

#: src/postulo_imap/sync.py:50
#, draft
msgid "Security"
msgstr "Bezpieczeństwo"

#: src/postulo_imap/sync.py:45
#, draft
msgid "Server"
msgstr "Serwer"

