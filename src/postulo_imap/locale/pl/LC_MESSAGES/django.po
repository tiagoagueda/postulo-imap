#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "%(count)d nie udało się dopasować do aplikacji; załącz je ręcznie."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "A message with no subject"
msgstr "Wiadomość bez tematu"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Hasło aplikacji wszędzie tam, gdzie serwer je oferuje; Gmail wymaga go przy włączonym uwierzytelnianiu dwuskładnikowym. Przechowywane w postaci zaszyfrowanej."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Nie można dotrzeć do serwera. Sprawdź adres, port i ochronę."

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Flag it with %(keyword)s"
msgstr "Oznacz flagą %(keyword)s"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Flagowanie jest niewidoczne w większości klientów i sprawia, że każdy przebieg jest krótki. Pozostawienie skrzynki nietkniętej oznacza, że każda niedawna wiadomość jest czytana ponownie; tak czy inaczej nic nie jest sugerowane dwa razy."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Folder to read"
msgstr "Folder do odczytu"

#: src/postulo_imap/sync.py
#, fuzzy
