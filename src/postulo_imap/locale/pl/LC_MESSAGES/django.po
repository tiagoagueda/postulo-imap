#, python-format, draft
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Zalogowano, ale nie ma folderu o nazwie „%(folder)s”."

#: src/postulo_imap/sync.py:158
#, python-format, draft
msgid "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr "Zalogowano. %(count)d wiadomości w „%(folder)s” czeka na odczytanie."

