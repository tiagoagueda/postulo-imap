#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d повідомлення не вдалося зіставити із заявкою; прикріпіть його вручну."
msgstr[1] "%(count)d повідомлення не вдалося зіставити із заявкою; прикріпіть їх вручну."
msgstr[2] "%(count)d повідомлень не вдалося зіставити із заявкою; прикріпіть їх вручну."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d повідомлення не вдалося прочитати, тож його пропущено."
msgstr[1] "%(count)d повідомлення не вдалося прочитати, тож їх пропущено."
msgstr[2] "%(count)d повідомлень не вдалося прочитати, тож їх пропущено."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Повідомлення без теми"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "відмова"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "відповідь на вже зіставлене повідомлення"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "підтвердження отримання"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Пароль застосунку, якщо сервер його пропонує; Gmail вимагає його, коли ввімкнено двофакторну автентифікацію. Зберігається зашифрованим."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "оцінювання"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "запрошення"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "пропозиція"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Не вдалося з’єднатися із сервером. Перевірте адресу, порт і захист."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Позначити прапорцем %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "Позначення прапорцем не видно в більшості клієнтів, і воно скорочує кожен прохід. Якщо поштову скриньку не чіпати, прохід читає лише листи, що надійшли після попереднього; у будь-якому разі нічого не пропонується двічі."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Тека для читання"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Наприклад, imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Від"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Вкажіть кількість днів від 1 до %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Вкажіть порт від 1 до 65535 або залиште поле порожнім."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "За скільки днів пошту розглядає один прохід."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Залишити поштову скриньку без змін"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Якщо порожньо: 993 з TLS, 143 зі STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Період перегляду"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Поштова скринька (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Розпізнано за"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Перемістити в підтеку"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Вкажіть підтеку, відмінну від теки, яку читають."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Вкажіть теку для читання. Postulo ніколи не читає «Вхідні»."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Вкажіть підтеку, куди переміщувати повідомлення."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "поки нічого"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Після прочитання"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Одна тека, ніколи не «Вхідні». Створіть на своєму поштовому сервері правило, яке складає сюди листи від рекрутерів; більше Postulo нічого не читає. Кожне прочитане повідомлення потім позначається прапорцем або переміщується — незалежно від того, чи його розпізнано."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Пароль або пароль застосунку"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Порт"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo ніколи не читає «Вхідні». Вкажіть теку, до якої ваше поштове правило складає листи про роботу."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Розпізнано"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Захист"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Сервер"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Вхід відхилено. Перевірте ім’я користувача й пароль."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Вхід виконано, але теки «%(folder)s» немає."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Вхід виконано, але цей сервер не вміє переміщувати повідомлення. Виберіть натомість позначення прапорцем."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Вхід виконано. У «%(folder)s» на прочитання чекає %(count)d повідомлення."
msgstr[1] "Вхід виконано. У «%(folder)s» на прочитання чекають %(count)d повідомлення."
msgstr[2] "Вхід виконано. У «%(folder)s» на прочитання чекають %(count)d повідомлень."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (порт 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Підтека"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "адреса контакту"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "назва компанії в повідомленні"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Не вдалося відкрити теку «%(folder)s»."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Поштова скринька відхилила пошук."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Поштова скринька відмовилася видати повідомлення."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Поштова скринька відмовилася шукати теку."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Повідомлення прочитано, але не вдалося позначити прапорцем; наступний прохід прочитає їх знову."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Повідомлення прочитано, але не вдалося перемістити до «%(folder)s»; наступний прохід прочитає їх знову."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Повідомлення прочитано, але цей сервер не вміє їх переміщувати; наступний прохід прочитає їх знову."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "назва посади в повідомленні"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "вебдомен відправника"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Ця тека не зберігає власних прапорців, тож Postulo запам’ятовує, де зупинився останній прохід, замість того щоб позначати прочитане прапорцем."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (порт 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Використовується лише тоді, коли повідомлення переміщуються. Створюється, якщо її немає."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Ім’я користувача"
