#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d не можа да бъде съпоставено с кандидатура; прикачете го ръчно."
msgstr[1] "%(count)d не можаха да бъдат съпоставени с кандидатура; прикачете ги ръчно."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d съобщение не можа да бъде прочетено и беше пропуснато."
msgstr[1] "%(count)d съобщения не можаха да бъдат прочетени и бяха пропуснати."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Съобщение без тема"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "отхвърляне"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "отговор на съобщение, което вече е съпоставено"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "потвърждение"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Парола за приложение, където сървърът предлага такава; Gmail я изисква при включено двуфакторно удостоверяване. Съхранява се шифровано."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "оценка"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "покана"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "предложение за работа"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Сървърът не може да бъде достигнат. Проверете адреса, порта и защитата."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Маркиране с %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr ""

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Папка за четене"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Например imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "От"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Въведете брой дни между 1 и %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Въведете порт между 1 и 65535 или оставете полето празно."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Колко дни поща разглежда едно преминаване."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Пощенската кутия да остане непроменена"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Ако е празно: 993 с TLS, 143 със STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Период назад"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Пощенска кутия (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Съпоставено по"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Преместване в подпапка"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Посочете подпапка, различна от папката, която се чете."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Посочете папката за четене. Postulo никога не чете входящата поща."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Посочете подпапката, в която да се преместват съобщенията."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "още нищо"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "След прочитане"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Една папка, никога входящата поща. Създайте правило на пощенския си сървър, което да прехвърля тук писмата от рекрутъри; Postulo не чете нищо друго. Всяко прочетено съобщение след това се маркира или премества, независимо дали е било разпознато."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Парола или парола за приложение"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Порт"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo никога не чете входящата поща. Посочете папката, в която вашето правило за пощата прехвърля писмата, свързани с работа."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Разпознато"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Сигурност"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Сървър"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Входът е отказан. Проверете потребителското име и паролата."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Влязохте, но няма папка с име „%(folder)s“."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Влизането е успешно, но този сървър не може да премества съобщения. Вместо това изберете маркиране."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Влизането е успешно. %(count)d съобщение в „%(folder)s“ чака да бъде прочетено."
msgstr[1] "Влизането е успешно. %(count)d съобщения в „%(folder)s“ чакат да бъдат прочетени."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (порт 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Подпапка"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "адрес на контакт"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "името на компанията в съобщението"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Папката „%(folder)s“ не можа да бъде отворена."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Пощенската кутия отказа търсенето."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Пощенската кутия отказа да предаде съобщенията."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Пощенската кутия отказа да потърси папката."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Съобщенията бяха прочетени, но не можаха да бъдат маркирани; следващото преминаване ще ги прочете отново."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Съобщенията бяха прочетени, но не можаха да бъдат преместени в „%(folder)s“; следващото преминаване ще ги прочете отново."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Съобщенията бяха прочетени, но този сървър не може да ги премести; следващото преминаване ще ги прочете отново."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "наименованието на длъжността в съобщението"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "уеб домейнът на подателя"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr ""

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (порт 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Използва се само когато съобщенията се преместват. Създава се, ако липсва."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Потребителско име"
