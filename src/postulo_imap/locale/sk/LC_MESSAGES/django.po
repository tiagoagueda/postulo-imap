#: src/postulo_imap/sync.py:217
#, python-format, draft
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "%(count)d sa nepodarilo priradiť k žiadosti; pripojte ich ručne."

#: src/postulo_imap/sync.py:190
#, draft
msgid "A message with no subject"
msgstr "Správa bez predmetu"

#: src/postulo_imap/sync.py:61
#, draft
msgid ""
"An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr ""
"Heslo aplikácie všade, kde ho server ponúka; Gmail ho vyžaduje pri zapnutom dvojfaktorovom overení. Uložené šifrovane."

#: src/postulo_imap/mailbox.py:282
msgid ""
"Could not reach the server. Check the address, the port and the security."
msgstr ""

#: src/postulo_imap/sync.py:84
#, python-format, draft
msgid "Flag it with %(keyword)s"
msgstr "Označiť príznakom %(keyword)s"

#: src/postulo_imap/sync.py:90
#, draft
msgid ""
"Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr ""
"Označenie príznakom je vo väčšine klientov neviditeľné a udržiava každý prechod krátky. Ponechanie schránky nedotknutej znamená, že každá nedávna správa sa číta znova; v oboch prípadoch sa nič nenavrhne dvakrát."

#: src/postulo_imap/sync.py:69
#, draft
msgid "Folder to read"
msgstr "Priečinok na čítanie"

#: src/postulo_imap/sync.py:41
#, draft
msgid "For example imap.example.org."
msgstr "Napríklad imap.example.org."

#: src/postulo_imap/sync.py:196
#, draft
msgid "From"
msgstr "Od"

#: src/postulo_imap/sync.py:111
#, draft
msgid "How many days of mail a pass considers."
msgstr "Koľko dní pošty jeden prechod zohľadňuje."

#: src/postulo_imap/sync.py:86
#, draft
msgid "Leave the mailbox untouched"
msgstr "Nechať schránku nedotknutú"

#: src/postulo_imap/sync.py:107
#, draft
msgid "Look back"
msgstr "Spätný rozsah"

#: src/postulo_imap/sync.py:36
#, draft
msgid "Mailbox (IMAP)"
msgstr "Schránka (IMAP)"

#: src/postulo_imap/sync.py:197
#, draft
msgid "Matched by"
msgstr "Priradené podľa"

#: src/postulo_imap/sync.py:85
#, draft
msgid "Move it to a subfolder"
msgstr "Presunúť do podpriečinka"

#: src/postulo_imap/sync.py:124
#, draft
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Uveďte priečinok na čítanie. Postulo nikdy nečíta doručenú poštu."

#: src/postulo_imap/sync.py:122
#, draft
msgid "Name the subfolder to move messages to."
msgstr "Uveďte podpriečinok, do ktorého sa správy presunú."

#: src/postulo_imap/sync.py:197
#, draft
msgid "nothing yet"
msgstr "zatiaľ nič"

#: src/postulo_imap/sync.py:81
#, draft
msgid "Once read"
msgstr "Po prečítaní"

#: src/postulo_imap/sync.py:73
#, draft
msgid ""
"One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else."
msgstr ""
"Jeden priečinok, nikdy nie doručená pošta. Vytvorte na poštovom serveri pravidlo, ktoré sem ukladá poštu od náborárov; Postulo nečíta nič iné."

#: src/postulo_imap/sync.py:57
#, draft
