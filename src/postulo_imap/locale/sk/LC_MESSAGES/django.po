#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d správu sa nepodarilo priradiť k žiadnej žiadosti; priraďte ju ručne."
msgstr[1] "%(count)d správy sa nepodarilo priradiť k žiadnej žiadosti; priraďte ich ručne."
msgstr[2] "%(count)d správ sa nepodarilo priradiť k žiadnej žiadosti; priraďte ich ručne."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d správu sa nepodarilo prečítať a bola preskočená."
msgstr[1] "%(count)d správy sa nepodarilo prečítať a boli preskočené."
msgstr[2] "%(count)d správ sa nepodarilo prečítať a boli preskočené."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Správa bez predmetu"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "odmietnutie"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "odpoveď na správu, ktorá už bola spárovaná"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "potvrdenie"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Heslo aplikácie všade, kde ho server ponúka; Gmail ho vyžaduje pri zapnutom dvojfaktorovom overení. Ukladá sa zašifrovane."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "hodnotenie"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "pozvánka"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "ponuka"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Server sa nepodarilo kontaktovať. Skontrolujte adresu, port a zabezpečenie."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Označiť príznakom %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Označenie príznakom je vo väčšine klientov neviditeľné a udržiava každý prechod krátky. Ponechanie schránky nedotknutej znamená, že každá nedávna správa sa číta znova; v oboch prípadoch sa nič nenavrhne dvakrát."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Priečinok na čítanie"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Napríklad imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Od"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Uveďte počet dní od 1 do %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Uveďte port od 1 do 65535 alebo nechajte pole prázdne."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Koľko dní pošty jeden prechod zohľadňuje."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Nechať schránku nedotknutú"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Ak je prázdne: 993 s TLS, 143 so STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Spätný rozsah"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Schránka (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Priradené podľa"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Presunúť do podpriečinka"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Uveďte iný podpriečinok, než je priečinok, ktorý sa číta."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Uveďte priečinok na čítanie. Postulo nikdy nečíta doručenú poštu."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Uveďte podpriečinok, do ktorého sa správy presunú."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "zatiaľ nič"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Po prečítaní"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Jeden priečinok, nikdy nie doručená pošta. Na poštovom serveri si vytvorte pravidlo, ktoré sem bude ukladať poštu od náborárov; Postulo nečíta nič iné. Každá prečítaná správa sa potom označí príznakom alebo presunie, či už bola rozpoznaná, alebo nie."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Heslo alebo heslo aplikácie"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo nikdy nečíta doručenú poštu. Uveďte priečinok, do ktorého vaše pravidlo ukladá pracovnú poštu."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Rozpoznané"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Zabezpečenie"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Server"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Prihlásenie bolo odmietnuté. Skontrolujte používateľské meno a heslo."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Prihlásenie prebehlo, ale priečinok „%(folder)s“ neexistuje."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Prihlásenie prebehlo, ale tento server nedokáže presúvať správy. Zvoľte radšej označenie príznakom."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Prihlásenie prebehlo. %(count)d správa v priečinku „%(folder)s“ čaká na prečítanie."
msgstr[1] "Prihlásenie prebehlo. %(count)d správy v priečinku „%(folder)s“ čakajú na prečítanie."
msgstr[2] "Prihlásenie prebehlo. %(count)d správ v priečinku „%(folder)s“ čaká na prečítanie."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Podpriečinok"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "adresa kontaktu"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "názov firmy v správe"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Priečinok „%(folder)s“ sa nepodarilo otvoriť."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Poštová schránka odmietla vyhľadávanie."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Poštová schránka odmietla odovzdať správy."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Poštová schránka odmietla hľadať priečinok."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Správy boli prečítané, ale nepodarilo sa ich označiť príznakom; pri ďalšom prechode sa prečítajú znova."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Správy boli prečítané, ale nepodarilo sa ich presunúť do „%(folder)s“; pri ďalšom prechode sa prečítajú znova."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Správy boli prečítané, ale tento server ich nedokáže presunúť; pri ďalšom prechode sa prečítajú znova."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "názov pozície v správe"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "webová doména odosielateľa"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so every message of the look-back is read again on each pass."
msgstr "Tento priečinok neukladá vlastné príznaky, preto sa každá správa zo spätného rozsahu pri každom prechode prečíta znova."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Používa sa len pri presúvaní správ. Ak chýba, vytvorí sa."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Používateľské meno"
