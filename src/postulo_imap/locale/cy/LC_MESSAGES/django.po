#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "Doedd dim modd cyfateb %(count)d i gais; atodwch hi â llaw."
msgstr[1] "Doedd dim modd cyfateb %(count)d i gais; atodwch nhw â llaw."
msgstr[2] "Doedd dim modd cyfateb %(count)d i gais; atodwch nhw â llaw."
msgstr[3] "Doedd dim modd cyfateb %(count)d i gais; atodwch nhw â llaw."

