#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Ni ellid cyrraedd y gweinydd. Gwiriwch y cyfeiriad, y porth a'r diogelwch."

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Flag it with %(keyword)s"
msgstr "Ei fflagio gyda %(keyword)s"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Mae fflagio'n anweledig yn y rhan fwyaf o raglenni e-bost ac yn cadw pob rhediad yn fyr. Mae gadael y blwch post yn ddigyffwrdd yn golygu bod pob neges ddiweddar yn cael ei darllen eto; nid oes dim yn cael ei awgrymu ddwywaith y naill ffordd na'r llall."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Folder to read"
msgstr "Ffolder i'w ddarllen"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "For example imap.example.org."
msgstr "Er enghraifft imap.example.org."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "From"
msgstr "Oddi wrth"

#: src/postulo_imap/sync.py
#, fuzzy, python-format
