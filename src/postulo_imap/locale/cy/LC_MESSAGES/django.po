msgstr "Porth"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Dyw Postulo byth yn darllen y mewnflwch. Enwch y ffolder y mae eich rheol e-bost yn ffeilio post swyddi iddi."

#: src/postulo_imap/sync.py
#, fuzzy
