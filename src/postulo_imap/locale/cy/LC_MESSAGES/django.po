msgstr[1] "Doedd dim modd darllen %(count)d neges, felly cawson nhw eu hepgor."
msgstr[2] "Doedd dim modd darllen %(count)d o negeseuon, felly cawson nhw eu hepgor."
msgstr[3] "Doedd dim modd darllen %(count)d o negeseuon, felly cawson nhw eu hepgor."

