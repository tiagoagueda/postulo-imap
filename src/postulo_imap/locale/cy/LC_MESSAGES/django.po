msgstr[1] "Wedi mewngofnodi. Mae %(count)d neges yn “%(folder)s” yn aros i gael eu darllen."
msgstr[2] "Wedi mewngofnodi. Mae %(count)d o negeseuon yn “%(folder)s” yn aros i gael eu darllen."
msgstr[3] "Wedi mewngofnodi. Mae %(count)d o negeseuon yn “%(folder)s” yn aros i gael eu darllen."

