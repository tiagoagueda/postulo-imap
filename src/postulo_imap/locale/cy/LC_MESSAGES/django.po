#: src/postulo_imap/sync.py
#, fuzzy
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Un ffolder, byth y mewnflwch. Gwnewch reol ar eich gweinydd e-bost sy'n ffeilio post recriwtwyr yma; dyw Postulo ddim yn darllen dim byd arall. Caiff pob neges y mae'n ei darllen ei fflagio neu ei symud wedyn, p'un a gafodd ei hadnabod ai peidio."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Cyfrinair neu gyfrinair ap"

#: src/postulo_imap/sync.py
#, fuzzy
