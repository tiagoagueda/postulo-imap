#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d kunde inte matchas mot en ansökan; koppla den manuellt."
msgstr[1] "%(count)d kunde inte matchas mot en ansökan; koppla dem manuellt."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d meddelande kunde inte läsas och hoppades över."
msgstr[1] "%(count)d meddelanden kunde inte läsas och hoppades över."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Ett meddelande utan ämne"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "ett avslag"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "ett svar på ett meddelande som redan matchats"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "en mottagningsbekräftelse"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Ett applösenord där servern erbjuder ett; Gmail kräver det när tvåfaktorsautentisering är på. Sparas krypterat."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "en bedömning"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "en inbjudan"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "ett erbjudande"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Det gick inte att nå servern. Kontrollera adressen, porten och säkerheten."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Flagga det med %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr ""

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Mapp att läsa"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Till exempel imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Från"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Ange ett antal dagar mellan 1 och %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Ange en port mellan 1 och 65535, eller lämna fältet tomt."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Hur många dagars e-post en genomgång tar med."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Lämna brevlådan orörd"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Lämnas tomt: 993 med TLS, 143 med STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Period bakåt"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Brevlåda (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Matchad via"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Flytta det till en undermapp"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Ange en annan undermapp än mappen som läses."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Ange mappen att läsa. Postulo läser aldrig inkorgen."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Ange undermappen att flytta meddelanden till."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "inget än"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "När det lästs"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "En mapp, aldrig inkorgen. Skapa en regel på din e-postserver som sorterar e-post från rekryterare hit; Postulo läser inget annat. Varje meddelande som läses flaggas eller flyttas efteråt, oavsett om det kändes igen eller inte."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Lösenord eller applösenord"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo läser aldrig inkorgen. Ange mappen dit din e-postregel sorterar jobbrelaterad e-post."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Igenkända"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Säkerhet"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Server"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Inloggningen nekades. Kontrollera användarnamnet och lösenordet."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Inloggad, men det finns ingen mapp som heter ”%(folder)s”."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Inloggad, men den här servern kan inte flytta meddelanden. Välj att flagga dem i stället."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Inloggad. %(count)d meddelande i ”%(folder)s” väntar på att läsas."
msgstr[1] "Inloggad. %(count)d meddelanden i ”%(folder)s” väntar på att läsas."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Undermapp"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "adressen till en kontakt"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "företagets namn i meddelandet"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Mappen ”%(folder)s” kunde inte öppnas."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Brevlådan avvisade sökningen."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Brevlådan vägrade lämna ut meddelandena."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Brevlådan vägrade leta efter mappen."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Meddelandena lästes men kunde inte flaggas; nästa genomgång läser dem igen."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Meddelandena lästes men kunde inte flyttas till ”%(folder)s”; nästa genomgång läser dem igen."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Meddelandena lästes, men den här servern kan inte flytta dem; nästa genomgång läser dem igen."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "rollens titel i meddelandet"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "avsändarens webbdomän"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr ""

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Används bara när meddelanden flyttas. Skapas om den saknas."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Användarnamn"
