#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d nuk mund të përputhej me një aplikim; bashkëngjiteni me dorë."
msgstr[1] "%(count)d nuk mund të përputheshin me një aplikim; bashkëngjitini me dorë."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d mesazh nuk mund të lexohej dhe u anashkalua."
msgstr[1] "%(count)d mesazhe nuk mund të lexoheshin dhe u anashkaluan."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Një mesazh pa subjekt"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "një refuzim"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "një përgjigje për një mesazh tashmë të përputhur"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "një konfirmim marrjeje"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Një fjalëkalim aplikacioni kudo që serveri e ofron; Gmail e kërkon kur është aktiv vërtetimi me dy faktorë. Ruhet i enkriptuar."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "një vlerësim"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "një ftesë"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "një ofertë"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Serveri nuk u arrit. Kontrolloni adresën, portën dhe sigurinë."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Shënoje me %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "Shënimi me flamur nuk duket në shumicën e klientëve dhe e mban çdo kalim të shkurtër. Kur kutia postare lihet e paprekur, një kalim lexon vetëm mesazhet që kanë mbërritur që nga kalimi i fundit; në të dyja rastet, asgjë nuk sugjerohet dy herë."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Dosja për t'u lexuar"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "P.sh. imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Nga"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Jepni një numër ditësh midis 1 dhe %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Jepni një portë midis 1 dhe 65535, ose lëreni bosh."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Sa ditë postë merr parasysh një kalim."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Lëre kutinë postare të paprekur"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Nëse lihet bosh: 993 me TLS, 143 me STARTTLS."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Look back"
msgstr "Periudha e kontrollit"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Kutia postare (IMAP)"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Matched by"
msgstr "Përputhur sipas"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Zhvendose në një nëndosje"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Jepni një nëndosje tjetër nga dosja që lexohet."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Jepni emrin e dosjes për t'u lexuar. Postulo nuk e lexon kurrë kutinë hyrëse."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Jepni emrin e nëndosjes ku do të zhvendosen mesazhet."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "ende asgjë"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Pasi lexohet"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Një dosje, kurrë kutia hyrëse. Krijoni një rregull në serverin tuaj të postës që i vendos këtu emailet e rekrutuesve; Postulo nuk lexon asgjë tjetër. Çdo mesazh që lexon shënohet me flamur ose zhvendoset më pas, qoftë i njohur apo jo."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Fjalëkalim ose fjalëkalim aplikacioni"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Porta"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo nuk e lexon kurrë kutinë hyrëse. Jepni emrin e dosjes ku rregulli juaj i postës vendos emailet për punë."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Recognised"
msgstr "Të njohura"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Siguria"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Serveri"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Hyrja u refuzua. Kontrolloni emrin e përdoruesit dhe fjalëkalimin."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Hyrja u krye, por nuk ka asnjë dosje të quajtur “%(folder)s”."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Hyrja u krye, por ky server nuk mund të zhvendosë mesazhe. Zgjidhni t'i shënoni me flamur."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Hyrja u krye. %(count)d mesazh në “%(folder)s” pret të lexohet."
msgstr[1] "Hyrja u krye. %(count)d mesazhe në “%(folder)s” presin të lexohen."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Nëndosja"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "adresa e një kontakti"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "emri i kompanisë në mesazh"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Dosja “%(folder)s” nuk mund të hapej."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Kutia postare e refuzoi kërkimin."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Kutia postare refuzoi të dorëzojë mesazhet."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Kutia postare refuzoi të kërkojë dosjen."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Mesazhet u lexuan, por nuk mund të shënoheshin me flamur; kalimi i radhës do t'i lexojë sërish."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Mesazhet u lexuan, por nuk mund të zhvendoseshin te “%(folder)s”; kalimi i radhës do t'i lexojë sërish."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Mesazhet u lexuan, por ky server nuk mund t'i zhvendosë; kalimi i radhës do t'i lexojë sërish."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "titulli i pozicionit në mesazh"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "domeni i uebit i dërguesit"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Kjo dosje nuk mban flamuj të vetët, ndaj Postulo-ja kujton ku ka ndalur kalimi i fundit, në vend që të shënojë me flamur atë që ka lexuar."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (porta 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Përdoret vetëm kur zhvendosen mesazhet. Krijohet nëse mungon."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Emri i përdoruesit"
