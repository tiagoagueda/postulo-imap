#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "%(count)d nuk mund të korrespondohet me një aplikativ; bashkangjitini me dorë."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "A message with no subject"
msgstr "Një mesazh pa subjekt"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Një fjalëkalim aplikativi kudo që serveri ofron një; Gmail kërkon që ai të ketë një autentifikimi me dy gjëndje. I koduar."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "E pamundur hyrja në server. Kontrollo adresën, portin dhe sigurinë."

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Flag it with %(keyword)s"
msgstr "Flamur atë me %(keyword)s"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Në shumicën e klientëve, bërja e flamurëve është e padukshme dhe e mban secilin të shkurtër. Lënia e mailbox e paprekur do të thotë që çdo mesazh i fundit të lexohet përsëri; asgjë nuk sugjerohet dy herë në të dyja mënyrat."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Folder to read"
msgstr "Kartelë për tu lexuar"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "For example imap.example.org."
msgstr "P.sh. iplam.org."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "From"
msgstr "Nga"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "How many days of mail a pass considers."
msgstr "Sa ditë postë merr në konsideratë."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Leave the mailbox untouched"
msgstr "Largohu nga mailbox i paprekur"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Look back"
msgstr "Shiko mbrapa"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Mailbox (IMAP)"
msgstr "Mailbox (IMAP)"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Matched by"
msgstr "Korrispondon me"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Move it to a subfolder"
msgstr "Lëvize atë në një nënfolës"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Shtoje kartelën për të lexuar. Populo nuk e lexon kurrë kutinë."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Name the subfolder to move messages to."
msgstr "Shkruaj një nën-kartelë ku duhen dërguar mesazhe."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "nothing yet"
msgstr "ende asgjë"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Once read"
msgstr "Lexim"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else."
msgstr "Një kartelë, kurrë në kuti. Vendos një rregull në serverin tënd mail që do të regjistrojë postën këtu; Postulo nuk lexon asgjë tjetër."

#: src/postulo_imap/sync.py
#, fuzzy
