#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d konnt keng Kandidatur zougeuerdnet ginn; hänkt en vun Hand un."
msgstr[1] "%(count)d konnte keng Kandidatur zougeuerdnet ginn; hänkt se vun Hand un."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d Message konnt net gelies ginn a gouf iwwersprongen."
msgstr[1] "%(count)d Messagë konnten net gelies ginn a goufen iwwersprongen."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "E Message ouni Sujet"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "eng Oflehnung"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "eng Äntwert op e Message, dee scho zougeuerdnet gouf"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "eng Empfangsbestätegung"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "En App-Passwuert, iwwerall wou de Server eent ubitt; Gmail verlaangt et, wann d'Zwee-Faktor-Authentifikatioun ugeschalt ass. Verschlësselt gespäichert."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "eng Evaluatioun"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "eng Invitatioun"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "eng Offer"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "De Server war net z'erreechen. Kontrolléiert d'Adress, de Port an d'Sécherheet."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Mat %(keyword)s markéieren"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "D'Markéieren ass an deene meeschte Mailprogrammer onsichtbar an hält all Duerchgang kuerz. Wann d'Postfach onberéiert bleift, gëtt all rezente Message nach eng Kéier gelies; op déi eng wéi op déi aner Manéier gëtt näischt zweemol virgeschloen."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Dossier, deen gelies gëtt"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Zum Beispill imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Ofsender"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Gitt eng Zuel vun Deeg tëscht 1 an %(max)d un."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Gitt e Port tëscht 1 a 65535 un, oder loosst en eidel."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Wéi vill Deeg u E-Mailen en Duerchgang berécksiichtegt."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "D'Postfach net upaken"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Eidel gelooss: 993 mat TLS, 143 mat STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Zréckkucken"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Postfach (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Erkannt iwwer"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "An en Ënnerdossier réckelen"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Gitt en Ënnerdossier un, deen net den Dossier ass, dee gelies gëtt."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Gitt den Dossier un, deen gelies soll ginn. De Postulo liest ni d'Inbox."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Gitt den Ënnerdossier un, an deen d'Messagë geréckelt solle ginn."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "nach näischt"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Nom Liesen"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Een Dossier, ni d'Inbox. Maacht op Ärem Mailserver eng Regel, déi d'E-Maile vu Recruteuren hei ofleet; de Postulo liest näischt anescht. All Message, deen e liest, gëtt duerno markéiert oder geréckelt, egal ob en erkannt gouf oder net."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Passwuert oder App-Passwuert"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "De Postulo liest ni d'Inbox. Gitt den Dossier un, an deen Är Mailregel d'E-Mailen iwwer Aarbechtsplazen ofleet."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Erkannt"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Sécherheet"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Server"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Umeldung refuséiert. Kontrolléiert de Benotzernumm an d'Passwuert."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Ugemellt, mä et gëtt keen Dossier mam Numm „%(folder)s“."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Ugemellt, mä dëse Server kann keng Messagë réckelen. Wielt amplaz, se ze markéieren."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Ugemellt. %(count)d Message an „%(folder)s“ waart drop, gelies ze ginn."
msgstr[1] "Ugemellt. %(count)d Messagen an „%(folder)s“ waarden drop, gelies ze ginn."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (Port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Ënnerdossier"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "d'Adress vun engem Kontakt"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "den Numm vun der Firma am Message"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Den Dossier „%(folder)s“ konnt net opgemaach ginn."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "D'Postfach huet d'Sich refuséiert."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "D'Postfach huet refuséiert, d'Messagen erauszeginn."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "D'Postfach huet refuséiert, nom Dossier ze sichen."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "D'Messagë goufe gelies, mä konnten net markéiert ginn; beim nächsten Duerchgang gi se nach eng Kéier gelies."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "D'Messagë goufe gelies, mä konnten net an „%(folder)s“ geréckelt ginn; beim nächsten Duerchgang gi se nach eng Kéier gelies."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "D'Messagë goufe gelies, mä dëse Server kann se net réckelen; beim nächsten Duerchgang gi se nach eng Kéier gelies."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "den Titel vun der Stell am Message"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "d'Webdomain vum Ofsender"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so every message of the look-back is read again on each pass."
msgstr "Dësen Dossier hält keng eege Markéierungen, dofir gëtt all Message aus dem Réckbléckzäitraum bei all Duerchgang nach eng Kéier gelies."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (Port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Gëtt nëmme benotzt, wann Messagë geréckelt ginn. Gëtt ugeluecht, wann e feelt."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Benotzernumm"
