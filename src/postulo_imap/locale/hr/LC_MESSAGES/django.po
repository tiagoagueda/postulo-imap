#, fuzzy, python-format
msgid "Flag it with %(keyword)s"
msgstr "Označi zastavicom %(keyword)s"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Zastavica je nevidljiva u većini klijenata i svaki prolaz ostaje kratak. Ako sandučić ostane netaknut, svaka nedavna poruka čita se iznova; ni u jednom slučaju ništa se ne predlaže dvaput."

