#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d se nije mogla povezati s prijavom; priložite je ručno."
msgstr[1] "%(count)d nisu se mogle povezati s prijavom; priložite ih ručno."
msgstr[2] "%(count)d nije se moglo povezati s prijavom; priložite ih ručno."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d poruka nije se mogla pročitati i preskočena je."
msgstr[1] "%(count)d poruke nisu se mogle pročitati i preskočene su."
msgstr[2] "%(count)d poruka nije se moglo pročitati, pa su preskočene."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Poruka bez predmeta"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "odbijenica"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "odgovor na već uparenu poruku"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "potvrda primitka"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Lozinka aplikacije gdje god je poslužitelj nudi; Gmail je zahtijeva kad je uključena dvofaktorska provjera. Sprema se šifrirano."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "procjena"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "poziv"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "ponuda"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Poslužitelj nije dostupan. Provjerite adresu, port i sigurnost."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Označi zastavicom %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Označavanje zastavicom nevidljivo je u većini klijenata i svaki prolaz drži kratkim. Ako sandučić ostane netaknut, svaka se nedavna poruka čita iznova; ni u jednom slučaju ništa se ne predlaže dvaput."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Mapa za čitanje"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Na primjer imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Od"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Navedite broj dana između 1 i %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Navedite priključak između 1 i 65535 ili ga ostavite praznim."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Koliko dana pošte jedan prolaz uzima u obzir."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Ostavi sandučić netaknutim"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Ako je prazno: 993 uz TLS, 143 uz STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Razdoblje unatrag"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Poštanski sandučić (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Povezano prema"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Premjesti u podmapu"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Navedite podmapu različitu od mape koja se čita."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Navedite mapu za čitanje. Postulo nikada ne čita ulaznu poštu."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Navedite podmapu u koju se poruke premještaju."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "još ništa"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Nakon čitanja"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Jedna mapa, nikad ulazna pošta. Napravite pravilo na svom poslužitelju e-pošte koje ovamo razvrstava poštu regrutera; Postulo ne čita ništa drugo. Svaka poruka koju pročita poslije se označava zastavicom ili premješta, bez obzira na to je li prepoznata."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Lozinka ili lozinka aplikacije"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo nikad ne čita ulaznu poštu. Navedite mapu u koju vaše pravilo e-pošte razvrstava poštu o poslovima."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Prepoznato"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Sigurnost"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Poslužitelj"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Prijava je odbijena. Provjerite korisničko ime i lozinku."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Prijava je uspjela, ali ne postoji mapa pod nazivom „%(folder)s“."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Prijava je uspjela, ali ovaj poslužitelj ne može premještati poruke. Umjesto toga odaberite označavanje zastavicom."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Prijavljeni ste. %(count)d poruka u mapi „%(folder)s” čeka na čitanje."
msgstr[1] "Prijavljeni ste. %(count)d poruke u mapi „%(folder)s” čekaju na čitanje."
msgstr[2] "Prijavljeni ste. %(count)d poruka u mapi „%(folder)s” čeka na čitanje."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Podmapa"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "adresa kontakta"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "naziv tvrtke u poruci"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Mapa „%(folder)s“ nije se mogla otvoriti."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Poštanski sandučić odbio je pretraživanje."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Poštanski sandučić odbio je predati poruke."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Poštanski sandučić odbio je potražiti mapu."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Poruke su pročitane, ali nisu se mogle označiti zastavicom; sljedeći prolaz pročitat će ih ponovno."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Poruke su pročitane, ali nisu se mogle premjestiti u „%(folder)s”; sljedeći prolaz pročitat će ih ponovno."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Poruke su pročitane, ali ovaj ih poslužitelj ne može premjestiti; sljedeći prolaz pročitat će ih ponovno."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "naziv radnog mjesta u poruci"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "web-domena pošiljatelja"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so every message of the look-back is read again on each pass."
msgstr "Ova mapa ne čuva vlastite zastavice, pa se svaka poruka iz razdoblja pregleda unatrag ponovno čita pri svakom prolazu."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Koristi se samo kad se poruke premještaju. Stvara se ako ne postoji."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Korisničko ime"
