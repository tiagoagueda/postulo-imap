msgstr "Boðini vórðu lisin, men kundu ikki flytast til „%(folder)s“; næsta umfar fer at lesa tey aftur."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Boðini vórðu lisin, men hesin ambætarin kann ikki flyta tey; næsta umfar fer at lesa tey aftur."

#: src/postulo_imap/matching.py
#, fuzzy
