#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d kundi ikki parast við eina umsókn; knýt tað at einari við hond."
msgstr[1] "%(count)d kundu ikki parast við eina umsókn; knýt tey at einari við hond."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d boð kundi ikki lesast og varð leypt um."
msgstr[1] "%(count)d boð kundu ikki lesast og vórðu leypt um."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Eini boð uttan evni"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "ein avsláttur"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "eitt svar til eini boð, sum longu eru pørd"

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an acknowledgement"
msgstr "ein móttøkuváttan"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Eitt app-loyniorð, har ambætarin bjóðar eitt; Gmail krevur tað, tá ið tvífaktorváttan er tendrað. Goymt bronglað."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "ein meting"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "ein innbjóðing"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "eitt tilboð"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Kundi ikki røkka ambætaranum. Kanna adressuna, portin og trygdina."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Merk tað við %(keyword)s"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "Merking sæst ikki í flestu skiparum og heldur hvørja ígjøgnumgongd stutta. Verður postkassin latin vera, les ein ígjøgnumgongd bara tey boð, sum eru komin síðani seinast; einki verður tikið uppá tvær ferðir, hvussu so er."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Mappa at lesa"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Til dømis imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Frá"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Gev eitt tal av døgum millum 1 og %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Gev ein port millum 1 og 65535, ella lat tað vera tómt."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Hvussu nógvar dagar aftur í tíð eitt umfar tekur við."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Lat postkassan vera ónomnan"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Latið tómt: 993 við TLS, 143 við STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Hygg aftur í tíð"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Postkassi (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Parað við"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Flyt tað til eina undirmappu"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Nevn eina aðra undirmappu enn mappuna, sum verður lisin."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Nevn mappuna, sum skal lesast. Postulo lesur ongantíð innbakkan."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Nevn undirmappuna, sum boð skulu flytast til."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "einki enn"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Tá ið tað er lisið"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Ein mappa, ongantíð innbakkin. Ger eina reglu á teldupostambætaranum, sum leggur post frá starvsútvegarum her; Postulo lesur einki annað. Hvørt boð, tað lesur, verður merkt ella flutt aftaná, hvørt tað varð kent aftur ella ei."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Loyniorð ella app-loyniorð"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Portur"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo lesur ongantíð innbakkan. Nevn mappuna, sum postreglan hjá tær leggur starvspost í."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Kent aftur"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Trygd"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Ambætari"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Innritan noktað. Kanna brúkaranavnið og loyniorðið."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Innritað, men eingin mappa eitur „%(folder)s“."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Innritað, men hesin ambætarin kann ikki flyta boð. Vel at merkja tey í staðin."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Innritað. %(count)d boð í „%(folder)s“ bíðar eftir at verða lisið."
msgstr[1] "Innritað. %(count)d boð í „%(folder)s“ bíða eftir at verða lisin."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (portur 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Undirmappa"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "adressan hjá einum sambandspersóni"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "navnið á fyritøkuni í boðunum"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Mappan „%(folder)s“ kundi ikki latast upp."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Postkassin noktaði leitingini."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Postkassin noktaði at lata boðini úr hondum."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Postkassin noktaði at leita eftir mappuni."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Boðini vórðu lisin, men kundu ikki merkjast; næsta umfar fer at lesa tey aftur."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Boðini vórðu lisin, men kundu ikki flytast til „%(folder)s“; næsta umfar fer at lesa tey aftur."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Boðini vórðu lisin, men hesin ambætarin kann ikki flyta tey; næsta umfar fer at lesa tey aftur."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "heitið á starvinum í boðunum"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "vevøkið hjá sendaranum"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Hendan mappan goymir ikki egin merki, so Postulo minnist, hvar seinasta ígjøgnumgongd steðgaði, heldur enn at merkja tað, hon las."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (portur 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Bert brúkt, tá ið boð verða flutt. Stovnað, um hon vantar."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Brúkaranavn"
