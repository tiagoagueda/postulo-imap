#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "%(count)d मैसेज किसी आवेदन से मेल नहीं खा सके; उन्हें हाथ से अटैच करें।"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "A message with no subject"
msgstr "बिना विषय का मैसेज"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "जहां सर्वर ऐप पासवर्ड देता हो, वहां ऐप पासवर्ड; टू-फ़ैक्टर ऑथेंटिकेशन चालू होने पर Gmail में यह ज़रूरी है। एन्क्रिप्ट करके रखा जाता है।"

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "सर्वर तक नहीं पहुंचा जा सका। पता, पोर्ट और सुरक्षा जांचें।"

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Flag it with %(keyword)s"
msgstr "%(keyword)s से चिह्नित करें"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "ज़्यादातर क्लाइंट में चिह्न दिखाई नहीं देता और इससे हर बार की जांच छोटी रहती है। मेलबॉक्स को ज्यों का त्यों छोड़ने पर हाल के सभी मैसेज फिर से पढ़े जाते हैं; दोनों ही तरह से कोई सुझाव दो बार नहीं दिया जाता।"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Folder to read"
msgstr "पढ़ने के लिए फ़ोल्डर"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "For example imap.example.org."
msgstr "उदाहरण के लिए imap.example.org।"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "From"
msgstr "से"

