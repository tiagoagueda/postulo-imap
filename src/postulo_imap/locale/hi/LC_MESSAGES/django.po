#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d का किसी आवेदन से मिलान नहीं हो सका; इसे हाथ से जोड़ें।"
msgstr[1] "%(count)d का किसी आवेदन से मिलान नहीं हो सका; इन्हें हाथ से जोड़ें।"

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d मैसेज पढ़ा नहीं जा सका और छोड़ दिया गया।"
msgstr[1] "%(count)d मैसेज पढ़े नहीं जा सके और छोड़ दिए गए।"

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "बिना विषय का मैसेज"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "अस्वीकृति"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "पहले से मिलान किए गए मैसेज का जवाब"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "प्राप्ति की पुष्टि"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "जहां सर्वर ऐप पासवर्ड देता हो, वहां ऐप पासवर्ड; टू-फ़ैक्टर ऑथेंटिकेशन चालू होने पर Gmail में यह ज़रूरी है। एन्क्रिप्ट करके रखा जाता है।"

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "मूल्यांकन"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "आमंत्रण"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "ऑफ़र"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "सर्वर तक नहीं पहुंचा जा सका। पता, पोर्ट और सुरक्षा जांचें।"

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "%(keyword)s से फ़्लैग करें"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "ज़्यादातर क्लाइंट में फ़्लैग दिखता नहीं है और इससे हर पास छोटा रहता है। मेलबॉक्स को जस का तस छोड़ने पर हर पास सिर्फ़ वही मैसेज पढ़ता है जो पिछले पास के बाद आए हैं; दोनों ही तरह किसी चीज़ को दो बार नहीं सुझाया जाता।"

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "पढ़ने के लिए फ़ोल्डर"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "उदाहरण के लिए imap.example.org।"

#: src/postulo_imap/sync.py
msgid "From"
msgstr "से"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "1 और %(max)d के बीच दिनों की संख्या दें।"

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "1 और 65535 के बीच कोई पोर्ट दें, या इसे खाली छोड़ें।"

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "हर बार कितने दिनों के मेल देखे जाते हैं।"

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "मेलबॉक्स को ज्यों का त्यों छोड़ें"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "खाली छोड़ने पर: TLS के साथ 993, STARTTLS के साथ 143।"

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "कितने दिन पीछे देखें"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "मेलबॉक्स (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "मिलान का आधार"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "सबफ़ोल्डर में ले जाएं"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "पढ़े जा रहे फ़ोल्डर के अलावा कोई दूसरा सबफ़ोल्डर बताएं।"

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "पढ़ने के लिए फ़ोल्डर का नाम बताएं। Postulo कभी इनबॉक्स नहीं पढ़ता।"

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "उस सबफ़ोल्डर का नाम बताएं जिसमें मैसेज ले जाने हैं।"

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "अभी तक कुछ नहीं"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "पढ़ने के बाद"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "एक फ़ोल्डर, कभी इनबॉक्स नहीं। अपने मेल सर्वर पर ऐसा नियम बनाएं जो रिक्रूटर के मेल यहां रखे; Postulo और कुछ नहीं पढ़ता। यह जो भी मैसेज पढ़ता है, उसे बाद में फ़्लैग किया जाता है या सबफ़ोल्डर में ले जाया जाता है, चाहे वह पहचाना गया हो या नहीं।"

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "पासवर्ड या ऐप पासवर्ड"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "पोर्ट"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo कभी इनबॉक्स नहीं पढ़ता। वह फ़ोल्डर बताएं जिसमें आपका मेल नियम नौकरी से जुड़े मेल रखता है।"

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "पहचाना गया"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "सुरक्षा"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "सर्वर"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "साइन-इन अस्वीकार किया गया। यूज़रनेम और पासवर्ड जांचें।"

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "साइन इन हो गया, लेकिन “%(folder)s” नाम का कोई फ़ोल्डर नहीं है।"

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "साइन इन हो गया, पर यह सर्वर मैसेज दूसरी जगह नहीं ले जा सकता। इसके बजाय उन्हें फ़्लैग करना चुनें।"

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "साइन इन हो गया। “%(folder)s” में %(count)d मैसेज पढ़े जाने का इंतज़ार कर रहा है।"
msgstr[1] "साइन इन हो गया। “%(folder)s” में %(count)d मैसेज पढ़े जाने का इंतज़ार कर रहे हैं।"

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (पोर्ट 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "सबफ़ोल्डर"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "संपर्क का पता"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "मैसेज में कंपनी का नाम"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "फ़ोल्डर “%(folder)s” खोला नहीं जा सका।"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "मेलबॉक्स ने खोज अस्वीकार कर दी।"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "मेलबॉक्स ने मैसेज देने से इनकार कर दिया।"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "मेलबॉक्स ने फ़ोल्डर खोजने से इनकार कर दिया।"

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "मैसेज पढ़े गए पर फ़्लैग नहीं किए जा सके; अगली बार उन्हें फिर से पढ़ा जाएगा।"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "मैसेज पढ़े गए पर “%(folder)s” में नहीं ले जाए जा सके; अगली बार उन्हें फिर से पढ़ा जाएगा।"

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "मैसेज पढ़े गए, पर यह सर्वर उन्हें दूसरी जगह नहीं ले जा सकता; अगली बार उन्हें फिर से पढ़ा जाएगा।"

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "मैसेज में पद का नाम"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "भेजने वाले का वेब डोमेन"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "इस फ़ोल्डर में अपने फ़्लैग नहीं रखे जाते, इसलिए Postulo पढ़े हुए मैसेज पर फ़्लैग लगाने के बजाय यह याद रखता है कि पिछला पास कहां रुका था।"

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (पोर्ट 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "सिर्फ़ तब इस्तेमाल होता है जब मैसेज ले जाए जाते हैं। न होने पर बनाया जाता है।"

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "यूज़रनेम"
