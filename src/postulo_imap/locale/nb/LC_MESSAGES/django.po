#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d kunne ikke kobles til en søknad; knytt den til manuelt."
msgstr[1] "%(count)d kunne ikke kobles til en søknad; knytt dem til manuelt."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d melding kunne ikke leses og ble hoppet over."
msgstr[1] "%(count)d meldinger kunne ikke leses og ble hoppet over."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "En melding uten emne"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "et avslag"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "et svar på en melding som allerede er koblet til"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "en bekreftelse"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Et app-passord der serveren tilbyr det; Gmail krever det når totrinnsbekreftelse er slått på. Lagres kryptert."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "en vurdering"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "en invitasjon"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "et tilbud"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Kunne ikke nå serveren. Kontroller adressen, porten og sikkerheten."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Merk den med %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr ""

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Mappe å lese i"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "For eksempel imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Fra"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Oppgi et antall dager mellom 1 og %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Oppgi en port mellom 1 og 65535, eller la feltet stå tomt."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Hvor mange dagers e-post en gjennomgang tar med."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "La postkassen være urørt"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Står det tomt: 993 med TLS, 143 med STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Se tilbake"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Postkasse (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Gjenkjent av"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Flytt den til en undermappe"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Oppgi en annen undermappe enn mappen som leses."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Oppgi mappen som skal leses. Postulo leser aldri innboksen."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Oppgi undermappen meldingene skal flyttes til."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "ingenting ennå"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Etter lesing"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Én mappe, aldri innboksen. Lag en regel på e-postserveren din som legger e-post fra rekrutterere her; Postulo leser ingenting annet. Hver melding den leser, blir merket eller flyttet etterpå, enten den ble gjenkjent eller ikke."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Passord eller app-passord"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo leser aldri innboksen. Oppgi mappen som e-postregelen din legger jobbrelatert e-post i."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Gjenkjent"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Sikkerhet"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Server"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Innloggingen ble avvist. Kontroller brukernavnet og passordet."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Logget inn, men det finnes ingen mappe som heter «%(folder)s»."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Logget inn, men denne serveren kan ikke flytte meldinger. Velg å merke dem i stedet."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Logget inn. %(count)d melding i «%(folder)s» venter på å bli lest."
msgstr[1] "Logget inn. %(count)d meldinger i «%(folder)s» venter på å bli lest."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Undermappe"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "adressen til en kontakt"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "selskapets navn i meldingen"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Mappen «%(folder)s» kunne ikke åpnes."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Postkassen avviste søket."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Postkassen nektet å levere meldingene."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Postkassen nektet å lete etter mappen."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Meldingene ble lest, men kunne ikke merkes; neste gjennomgang leser dem på nytt."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Meldingene ble lest, men kunne ikke flyttes til «%(folder)s»; neste gjennomgang leser dem på nytt."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Meldingene ble lest, men denne serveren kan ikke flytte dem; neste gjennomgang leser dem på nytt."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "stillingstittelen i meldingen"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "avsenderens webdomene"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr ""

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Brukes bare når meldinger flyttes. Opprettes hvis den mangler."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Brukernavn"
