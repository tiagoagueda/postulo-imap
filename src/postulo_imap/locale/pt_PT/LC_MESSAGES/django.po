#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "%(count)d não puderam ser associadas a uma candidatura; associe-as à mão."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Uma mensagem sem assunto"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Uma palavra-passe de aplicação sempre que o servidor a ofereça; o Gmail exige-a com a verificação em dois passos ativa. Guardada cifrada."

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Não foi possível contactar o servidor. Verifique o endereço, a porta e a segurança."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Marcá-lo com %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "A marca é invisível na maioria dos clientes e mantém cada passagem curta. Não mexer na caixa significa reler todas as mensagens recentes; de qualquer forma, nada é sugerido duas vezes."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Pasta a ler"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Por exemplo imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "De"

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Quantos dias de correio cada passagem considera."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Não mexer na caixa de correio"

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Recuar"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Caixa de correio (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Associado por"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Movê-lo para uma subpasta"

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Indique a pasta a ler. O Postulo nunca lê a caixa de entrada."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Indique a subpasta para onde mover as mensagens."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "ainda nada"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Depois de lido"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else."
msgstr "Uma pasta, nunca a caixa de entrada. Crie uma regra no seu servidor de correio que arquive aqui o correio dos recrutadores; o Postulo não lê mais nada."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Palavra-passe ou palavra-passe de aplicação"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Porta"

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Reconhecido"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Segurança"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Servidor"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Início de sessão recusado. Verifique o nome de utilizador e a palavra-passe."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Sessão iniciada, mas não existe nenhuma pasta chamada «%(folder)s»."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr "Sessão iniciada. %(count)d mensagens em «%(folder)s» esperam ser lidas."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (porta 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Subpasta"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Não foi possível abrir a pasta «%(folder)s»."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "A caixa de correio recusou a pesquisa."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "A caixa de correio recusou-se a entregar as mensagens."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (porta 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Usada apenas quando as mensagens são movidas. Criada se faltar."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Nome de utilizador"
