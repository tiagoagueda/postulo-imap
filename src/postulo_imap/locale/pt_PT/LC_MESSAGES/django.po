#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d mensagem não pôde ser associada a uma candidatura; anexe-a manualmente."
msgstr[1] "%(count)d mensagens não puderam ser associadas a uma candidatura; anexe-as manualmente."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d mensagem não pôde ser lida e foi ignorada."
msgstr[1] "%(count)d mensagens não puderam ser lidas e foram ignoradas."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Uma mensagem sem assunto"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "uma rejeição"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "uma resposta a uma mensagem já associada"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "uma confirmação de receção"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Uma palavra-passe de aplicação sempre que o servidor a ofereça; o Gmail exige-a com a verificação em dois passos ativa. Guardada cifrada."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "uma avaliação"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "um convite"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "uma oferta"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Não foi possível contactar o servidor. Verifique o endereço, a porta e a segurança."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Marcá-lo com %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "A marcação é invisível na maioria das aplicações de correio e mantém cada passagem curta. Deixar a caixa de correio intacta faz com que cada passagem leia apenas as mensagens chegadas desde a anterior; em qualquer dos casos, nada é sugerido duas vezes."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Pasta a ler"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Por exemplo imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "De"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Dê um número de dias entre 1 e %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Indique uma porta entre 1 e 65535, ou deixe-a vazia."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Quantos dias de correio cada passagem considera."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Não mexer na caixa de correio"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Se ficar vazio: 993 com TLS, 143 com STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Recuar"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Caixa de correio (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Associado por"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Movê-lo para uma subpasta"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Nomeie uma subpasta que não seja a pasta a ser lida."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Indique a pasta a ler. O Postulo nunca lê a caixa de entrada."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Indique a subpasta para onde mover as mensagens."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "ainda nada"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Depois de lido"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Uma pasta, nunca a caixa de entrada. Crie no seu servidor de correio uma regra que arquive aqui o correio dos recrutadores; o Postulo não lê mais nada. Cada mensagem que lê é depois marcada ou movida, tenha ou não sido reconhecida."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Palavra-passe ou palavra-passe de aplicação"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Porta"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "O Postulo nunca lê a caixa de entrada. Indique a pasta onde a sua regra de correio arquiva o correio de emprego."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Reconhecido"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Segurança"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Servidor"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Início de sessão recusado. Verifique o nome de utilizador e a palavra-passe."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Sessão iniciada, mas não existe nenhuma pasta chamada «%(folder)s»."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Sessão iniciada, mas este servidor não consegue mover mensagens. Em vez disso, escolha marcá-las."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Sessão iniciada. %(count)d mensagem em «%(folder)s» está à espera de ser lida."
msgstr[1] "Sessão iniciada. %(count)d mensagens em «%(folder)s» estão à espera de ser lidas."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (porta 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Subpasta"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "o endereço de um contacto"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "o nome da empresa na mensagem"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Não foi possível abrir a pasta «%(folder)s»."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "A caixa de correio recusou a pesquisa."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "A caixa de correio recusou-se a entregar as mensagens."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "A caixa de correio recusou-se a procurar a pasta."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "As mensagens foram lidas, mas não puderam ser marcadas; a próxima passagem vai lê-las novamente."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "As mensagens foram lidas, mas não puderam ser movidas para «%(folder)s»; a próxima passagem vai lê-las novamente."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "As mensagens foram lidas, mas este servidor não consegue movê-las; a próxima passagem vai lê-las novamente."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "o nome do cargo na mensagem"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "o domínio web do remetente"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Esta pasta não guarda marcações próprias, por isso o Postulo lembra-se de onde parou a última passagem, em vez de marcar o que leu."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (porta 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Usada apenas quando as mensagens são movidas. Criada se faltar."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Nome de utilizador"
