#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "%(count)d se nepodařilo přiřadit k žádosti; připojte je ručně."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "A message with no subject"
msgstr "Zpráva bez předmětu"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Heslo aplikace všude, kde ho server nabízí; Gmail ho vyžaduje při zapnutém dvoufázovém ověření. Uloženo šifrovaně."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Nepodařilo se dostat na server. Zkontrolujte adresu, přístav a zabezpečení."

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Flag it with %(keyword)s"
msgstr "Označit příznakem %(keyword)s"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Označení příznakem je ve většině klientů neviditelné a každý průchod zkracuje. Ponechání schránky nedotčené znamená, že se každá nedávná zpráva čte znovu; nic se ale v žádném případě nenavrhne dvakrát."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Folder to read"
msgstr "Složka ke čtení"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "For example imap.example.org."
msgstr "Například imap.example.org."

