#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "Poruke koje se nisu mogle povezati s prijavom: %(count)d; priložite ih ručno."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "A message with no subject"
msgstr "Poruka bez predmeta"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Lozinka aplikacije gdje god je server nudi; Gmail je zahtijeva kada je uključena potvrda u dva koraka. Pohranjena šifrirano."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Server nije dostupan. Provjerite adresu, port i sigurnost."

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Flag it with %(keyword)s"
msgstr "Označi je zastavicom %(keyword)s"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Zastavica se u većini klijenata ne vidi i svaki prolaz ostaje kratak. Ako sandučić ostane netaknut, svaka nedavna poruka čita se ponovo; ni u jednom slučaju ništa se ne predlaže dvaput."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Folder to read"
msgstr "Folder za čitanje"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "For example imap.example.org."
