#: src/postulo_imap/sync.py:221
#, python-format, draft
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr ""
"%(count)d no se pudieron asociar a ninguna candidatura; adjúntalos a mano."

#: src/postulo_imap/sync.py:194
#, draft
msgid "A message with no subject"
msgstr "Un mensaje sin asunto"

#: src/postulo_imap/sync.py:65
#, draft
msgid ""
"An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr ""
"Una contraseña de aplicación siempre que el servidor la ofrezca; Gmail la exige con la autenticación de dos factores activada. Se guarda cifrada."

#: src/postulo_imap/sync.py:88
#, python-format, draft
msgid "Flag it with %(keyword)s"
msgstr "Marcarlo con %(keyword)s"

#: src/postulo_imap/sync.py:94
#, draft
msgid ""
"Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr ""
"La marca es invisible en la mayoría de los clientes y mantiene corta cada pasada. Dejar el buzón intacto significa que cada mensaje reciente se vuelve a leer; en ningún caso se sugiere nada dos veces."

#: src/postulo_imap/sync.py:73
#, draft
msgid "Folder to read"
msgstr "Carpeta a leer"

#: src/postulo_imap/sync.py:45
#, draft
msgid "For example imap.example.org."
msgstr "Por ejemplo imap.example.org."

#: src/postulo_imap/sync.py:200
#, draft
msgid "From"
msgstr "De"

#: src/postulo_imap/sync.py:115
#, draft
msgid "How many days of mail a pass considers."
msgstr "Cuántos días de correo considera una pasada."

#: src/postulo_imap/sync.py:90
#, draft
msgid "Leave the mailbox untouched"
msgstr "Dejar el buzón intacto"

#: src/postulo_imap/sync.py:111
#, draft
msgid "Look back"
msgstr "Mirar atrás"

#: src/postulo_imap/sync.py:40
#, draft
msgid "Mailbox (IMAP)"
msgstr "Buzón (IMAP)"

#: src/postulo_imap/sync.py:201
#, draft
msgid "Matched by"
msgstr "Asociado por"

#: src/postulo_imap/sync.py:89
#, draft
msgid "Move it to a subfolder"
msgstr "Moverlo a una subcarpeta"

#: src/postulo_imap/sync.py:128
#, draft
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Indica la carpeta a leer. Postulo nunca lee la bandeja de entrada."

#: src/postulo_imap/sync.py:126
#, draft
msgid "Name the subfolder to move messages to."
msgstr "Indica la subcarpeta a la que mover los mensajes."

#: src/postulo_imap/sync.py:201
#, draft
msgid "nothing yet"
msgstr "nada todavía"

#: src/postulo_imap/sync.py:85
#, draft
msgid "Once read"
msgstr "Una vez leído"

#: src/postulo_imap/sync.py:77
#, draft
msgid ""
"One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else."
msgstr ""
"Una carpeta, nunca la bandeja de entrada. Crea una regla en tu servidor de correo que archive aquí el correo de los reclutadores; Postulo no lee nada más."

#: src/postulo_imap/sync.py:61
#, draft
msgid "Password or app password"
msgstr "Contraseña o contraseña de aplicación"

#: src/postulo_imap/sync.py:47
#, draft
msgid "Port"
msgstr "Puerto"

#: src/postulo_imap/sync.py:203
#, draft
msgid "Recognised"
msgstr "Reconocidos"

#: src/postulo_imap/sync.py:50
#, draft
msgid "Security"
msgstr "Seguridad"

#: src/postulo_imap/sync.py:45
#, draft
msgid "Server"
msgstr "Servidor"

#: src/postulo_imap/sync.py:143
#, python-format, draft
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Sesión iniciada, pero no hay ninguna carpeta llamada «%(folder)s»."

#: src/postulo_imap/sync.py:158
#, python-format, draft
msgid "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr ""
"Sesión iniciada. %(count)d mensajes en «%(folder)s» esperan a ser leídos."

#: src/postulo_imap/sync.py:54
#, draft
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (puerto 143)"

#: src/postulo_imap/sync.py:103
#, draft
msgid "Subfolder"
msgstr "Subcarpeta"

#: src/postulo_imap/sync.py:53
#, draft
msgid "TLS (port 993)"
msgstr "TLS (puerto 993)"

#: src/postulo_imap/sync.py:107
#, draft
msgid "Used only when messages are moved. Created if missing."
msgstr "Solo se usa cuando se mueven mensajes. Se crea si falta."

#: src/postulo_imap/sync.py:58
#, draft
msgid "Username"
msgstr "Nombre de usuario"
