#, python-format, draft
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Prijavljeno, a mape z imenom „%(folder)s“ ni."

#: src/postulo_imap/sync.py:154
#, python-format, draft
msgid "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr "Prijavljeno. V mapi „%(folder)s“ na branje čaka %(count)d sporočil."

#: src/postulo_imap/sync.py:50
#, draft
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (vrata 143)"

#: src/postulo_imap/sync.py:99
#, draft
msgid "Subfolder"
msgstr "Podmapa"

