#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d sporočilo ni bilo povezano s prijavo; pripnite ga ročno."
msgstr[1] "%(count)d sporočili nista bili povezani s prijavo; pripnite ju ročno."
msgstr[2] "%(count)d sporočila niso bila povezana s prijavo; pripnite jih ročno."
msgstr[3] "%(count)d sporočil ni bilo povezanih s prijavo; pripnite jih ročno."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d sporočilo ni bilo berljivo in je bilo preskočeno."
msgstr[1] "%(count)d sporočili nista bili berljivi in sta bili preskočeni."
msgstr[2] "%(count)d sporočila niso bila berljiva in so bila preskočena."
msgstr[3] "%(count)d sporočil ni bilo mogoče prebrati, zato so bila preskočena."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Sporočilo brez zadeve"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "zavrnitev"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "odgovor na sporočilo, ki je že povezano"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "potrditev"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Geslo za aplikacije povsod, kjer ga strežnik ponuja; Gmail ga zahteva pri vklopljeni dvostopenjski avtentikaciji. Shranjeno šifrirano."

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an assessment"
msgstr "ocena"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "vabilo"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "ponudba"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Strežnika ni mogoče doseči. Preverite naslov, vrata in varnost."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Označi z zastavico %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr ""

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Mapa za branje"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Na primer imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Od"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Navedite število dni med 1 in %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Navedite vrata med 1 in 65535 ali pustite prazno."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Koliko dni pošte upošteva en prehod."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Pusti poštni predal nedotaknjen"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Če ostane prazno: 993 s TLS, 143 s STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Pogled nazaj"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Poštni predal (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Ujemanje po"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Premakni v podmapo"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Navedite podmapo, ki ni mapa, iz katere se bere."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Navedite mapo za branje. Postulo nikoli ne bere mape Prejeto."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Navedite podmapo, kamor se premaknejo sporočila."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "še nič"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Po branju"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Ena mapa, nikoli mapa Prejeto. Na poštnem strežniku ustvarite pravilo, ki pošto rekruterjev premika sem; Postulo ne bere ničesar drugega. Vsako sporočilo, ki ga prebere, je nato označeno z zastavico ali premaknjeno, ne glede na to, ali je bilo prepoznano."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Geslo ali geslo za aplikacije"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Vrata"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo nikoli ne bere mape Prejeto. Navedite mapo, v katero vaše poštno pravilo premika pošto o zaposlitvah."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Prepoznano"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Varnost"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Strežnik"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Prijava zavrnjena. Preverite uporabniško ime in geslo."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Prijava je uspela, vendar mape z imenom »%(folder)s« ni."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Prijava je uspela, vendar ta strežnik ne more premikati sporočil. Namesto tega izberite označevanje z zastavico."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Prijava je uspela. V mapi »%(folder)s« čaka na branje %(count)d sporočilo."
msgstr[1] "Prijava je uspela. V mapi »%(folder)s« čakata na branje %(count)d sporočili."
msgstr[2] "Prijava je uspela. V mapi »%(folder)s« čakajo na branje %(count)d sporočila."
msgstr[3] "Prijava je uspela. V mapi »%(folder)s« čaka na branje %(count)d sporočil."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (vrata 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Podmapa"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "naslov stika"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "ime podjetja v sporočilu"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Mape »%(folder)s« ni bilo mogoče odpreti."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Poštni predal je zavrnil iskanje."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Poštni predal ni hotel predati sporočil."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Poštni predal je zavrnil iskanje mape."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Sporočila so bila prebrana, vendar jih ni bilo mogoče označiti; naslednji prehod jih bo ponovno prebral."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Sporočila so bila prebrana, vendar jih ni bilo mogoče premakniti v mapo »%(folder)s«; naslednji prehod jih bo ponovno prebral."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Sporočila so bila prebrana, vendar jih ta strežnik ne more premakniti; naslednji prehod jih bo ponovno prebral."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "naziv delovnega mesta v sporočilu"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "spletna domena pošiljatelja"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr ""

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (vrata 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Uporablja se samo, ko se sporočila premikajo. Če ne obstaja, se ustvari."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Uporabniško ime"
