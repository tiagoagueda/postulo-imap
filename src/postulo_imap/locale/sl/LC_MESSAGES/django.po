#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Označevanje z zastavico je v večini odjemalcev nevidno in ohranja vsak prehod kratek. Če poštni predal ostane nedotaknjen, se vsako nedavno sporočilo prebere znova; v nobenem primeru ni nič predlagano dvakrat."

