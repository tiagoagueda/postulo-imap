#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d no se pudo asociar a ninguna postulación; vincúlelo a mano."
msgstr[1] "%(count)d no se pudieron asociar a ninguna postulación; vincúlelos a mano."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d mensaje no se pudo leer y se omitió."
msgstr[1] "%(count)d mensajes no se pudieron leer y se omitieron."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Un mensaje sin asunto"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "un rechazo"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "una respuesta a un mensaje ya asociado"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "un acuse de recibo"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Una contraseña de aplicación siempre que el servidor la ofrezca; Gmail la exige si tienes activada la autenticación de dos factores. Se guarda cifrada."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "una evaluación"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "una invitación"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "una oferta"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "No se pudo conectar con el servidor. Revisa la dirección, el puerto y la seguridad."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Marcarlo con %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr ""

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Carpeta que se lee"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Por ejemplo, imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "De"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Indique un número de días entre 1 y %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Indique un puerto entre 1 y 65535, o déjelo vacío."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Cuántos días de correo considera cada pasada."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Dejar el buzón intacto"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Si se deja vacío: 993 con TLS, 143 con STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Días hacia atrás"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Buzón (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Asociado por"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Moverlo a una subcarpeta"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Indique una subcarpeta distinta de la carpeta que se lee."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Indica la carpeta que se lee. Postulo nunca lee la bandeja de entrada."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Indica la subcarpeta a la que se mueven los mensajes."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "nada todavía"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Una vez leído"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Una carpeta, nunca la bandeja de entrada. Cree una regla en su servidor de correo que archive aquí el correo de los reclutadores; Postulo no lee nada más. Cada mensaje que lee se marca o se mueve después, se haya reconocido o no."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Contraseña o contraseña de aplicación"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Puerto"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo nunca lee la bandeja de entrada. Indique la carpeta en la que su regla de correo archiva el correo sobre empleos."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Reconocido"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Seguridad"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Servidor"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Inicio de sesión rechazado. Revisa el nombre de usuario y la contraseña."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Sesión iniciada, pero no hay ninguna carpeta llamada \"%(folder)s\"."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Sesión iniciada, pero este servidor no puede mover mensajes. Elija marcarlos en su lugar."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Sesión iniciada. %(count)d mensaje de “%(folder)s” está esperando a ser leído."
msgstr[1] "Sesión iniciada. %(count)d mensajes de “%(folder)s” están esperando a ser leídos."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (puerto 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Subcarpeta"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "la dirección de un contacto"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "el nombre de la empresa en el mensaje"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "No se pudo abrir la carpeta \"%(folder)s\"."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "El buzón rechazó la búsqueda."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "El buzón se negó a entregar los mensajes."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "El buzón se negó a buscar la carpeta."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Los mensajes se leyeron, pero no se pudieron marcar; la próxima pasada los volverá a leer."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Los mensajes se leyeron, pero no se pudieron mover a “%(folder)s”; la próxima pasada los volverá a leer."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Los mensajes se leyeron, pero este servidor no puede moverlos; la próxima pasada los volverá a leer."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "el título del puesto en el mensaje"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "el dominio web del remitente"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr ""

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (puerto 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Solo se usa cuando se mueven los mensajes. Se crea si no existe."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Nombre de usuario"
