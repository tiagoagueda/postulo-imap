#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "Níorbh fhéidir %(count)d teachtaireacht a mheaitseáil le hiarratas; ceangail de láimh í."
msgstr[1] "Níorbh fhéidir %(count)d theachtaireacht a mheaitseáil le hiarratas; ceangail de láimh iad."
msgstr[2] "Níorbh fhéidir %(count)d theachtaireacht a mheaitseáil le hiarratas; ceangail de láimh iad."
msgstr[3] "Níorbh fhéidir %(count)d dteachtaireacht a mheaitseáil le hiarratas; ceangail de láimh iad."
msgstr[4] "Níorbh fhéidir %(count)d teachtaireacht a mheaitseáil le hiarratas; ceangail de láimh iad."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "Níorbh fhéidir %(count)d teachtaireacht a léamh agus fágadh ar lár í."
msgstr[1] "Níorbh fhéidir %(count)d theachtaireacht a léamh agus fágadh ar lár iad."
msgstr[2] "Níorbh fhéidir %(count)d theachtaireacht a léamh agus fágadh ar lár iad."
msgstr[3] "Níorbh fhéidir %(count)d dteachtaireacht a léamh agus fágadh ar lár iad."
msgstr[4] "Níorbh fhéidir %(count)d teachtaireacht a léamh agus fágadh ar lár iad."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Teachtaireacht gan ábhar"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "diúltú"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "freagra ar theachtaireacht a meaitseáladh cheana"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "admháil"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Pasfhocal aipe cibé áit a dtairgeann an freastalaí ceann; éilíonn Gmail é nuair a bhíonn fíordheimhniú dhá fhachtóir ar siúl. Stóráilte go criptithe."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "measúnú"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "cuireadh"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "tairiscint"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Níorbh fhéidir teacht ar an bhfreastalaí. Seiceáil an seoladh, an port agus an tslándáil."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Cuir bratach air le %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr ""

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Fillteán le léamh"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Mar shampla imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Ó"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Tabhair líon laethanta idir 1 agus %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Tabhair port idir 1 agus 65535, nó fág folamh é."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Cé mhéad lá ríomhphoist a mheasann rith amháin."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Fág an bosca poist gan athrú"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Má fhágtar folamh é: 993 le TLS, 143 le STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Tréimhse siar"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Bosca poist (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Meaitseáilte de réir"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Bog chuig fofhillteán é"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Ainmnigh fofhillteán seachas an fillteán atá á léamh."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Ainmnigh an fillteán le léamh. Ní léann Postulo an bosca isteach riamh."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Ainmnigh an fofhillteán a mbogfar teachtaireachtaí chuige."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "faic fós"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Nuair a bheidh sé léite"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Fillteán amháin, ní an bosca isteach choíche. Déan riail ar do fhreastalaí ríomhphoist a chuireann ríomhphost ó earcaitheoirí anseo; ní léann Postulo aon rud eile. Cuirtear bratach ar gach teachtaireacht a léann sé, nó bogtar í, ina dhiaidh sin, cibé ar aithníodh í nó nár aithníodh."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Pasfhocal nó pasfhocal aipe"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Ní léann Postulo an bosca isteach riamh. Ainmnigh an fillteán ina gcomhdaíonn do riail ríomhphoist teachtaireachtaí faoi phoist."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Aitheanta"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Slándáil"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Freastalaí"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Diúltaíodh don síniú isteach. Seiceáil an t-ainm úsáideora agus an pasfhocal."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Sínithe isteach, ach níl aon fhillteán darb ainm “%(folder)s” ann."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Sínithe isteach, ach ní féidir leis an bhfreastalaí seo teachtaireachtaí a bhogadh. Roghnaigh bratach a chur orthu ina ionad."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Sínithe isteach. Tá %(count)d teachtaireacht i “%(folder)s” ag fanacht le léamh."
msgstr[1] "Sínithe isteach. Tá %(count)d theachtaireacht i “%(folder)s” ag fanacht le léamh."
msgstr[2] "Sínithe isteach. Tá %(count)d theachtaireacht i “%(folder)s” ag fanacht le léamh."
msgstr[3] "Sínithe isteach. Tá %(count)d dteachtaireacht i “%(folder)s” ag fanacht le léamh."
msgstr[4] "Sínithe isteach. Tá %(count)d teachtaireacht i “%(folder)s” ag fanacht le léamh."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Fofhillteán"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "seoladh teagmhálaí"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "ainm na cuideachta sa teachtaireacht"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Níorbh fhéidir an fillteán “%(folder)s” a oscailt."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Dhiúltaigh an bosca poist an cuardach."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Dhiúltaigh an bosca poist na teachtaireachtaí a thabhairt uaidh."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Dhiúltaigh an bosca poist an fillteán a lorg."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Léadh na teachtaireachtaí ach níorbh fhéidir bratach a chur orthu; léifidh an chéad rith eile arís iad."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Léadh na teachtaireachtaí ach níorbh fhéidir iad a bhogadh go “%(folder)s”; léifidh an chéad rith eile arís iad."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Léadh na teachtaireachtaí, ach ní féidir leis an bhfreastalaí seo iad a bhogadh; léifidh an chéad rith eile arís iad."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "teideal an róil sa teachtaireacht"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "fearann gréasáin an tseoltóra"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr ""

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Ní úsáidtear é ach nuair a bhogtar teachtaireachtaí. Cruthaítear é mura bhfuil sé ann."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Ainm úsáideora"
