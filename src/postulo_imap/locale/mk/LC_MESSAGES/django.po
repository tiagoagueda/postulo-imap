#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d не можеше да се поврзе со пријава; поврзете ја рачно."
msgstr[1] "%(count)d не можеа да се поврзат со пријава; поврзете ги рачно."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d порака не можеше да се прочита и беше прескокната."
msgstr[1] "%(count)d пораки не можеа да се прочитаат и беа прескокнати."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Порака без наслов"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "одбивање"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "одговор на порака што веќе е поврзана"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "потврда за прием"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Лозинка за апликација секаде каде што серверот нуди таква; Gmail ја бара кога е вклучена двофакторска автентикација. Се чува шифрирано."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "проценка"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "покана"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "понуда"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Серверот не е достапен. Проверете ја адресата, портата и безбедноста."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Означи ја со %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr ""

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Папка за читање"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "На пример imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Од"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Внесете број на денови меѓу 1 и %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Внесете порта меѓу 1 и 65535 или оставете го празно."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Колку денови пошта зема предвид едно поминување."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Остави го поштенското сандаче недопрено"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Ако е празно: 993 со TLS, 143 со STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Период наназад"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Поштенско сандаче (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Поврзано според"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Премести ја во потпапка"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Именувајте потпапка различна од папката што се чита."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Наведете ја папката за читање. Postulo никогаш не го чита приемното сандаче."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Наведете ја потпапката во која ќе се преместуваат пораките."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "сè уште ништо"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Откако ќе се прочита"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Една папка, никогаш приемното сандаче. Направете правило на вашиот сервер за пошта што ја става тука поштата од регрутерите; Postulo не чита ништо друго. Секоја порака што ја прочита потоа се означува со знаменце или се преместува, без разлика дали е препознаена."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Лозинка или лозинка за апликација"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Порта"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo никогаш не го чита приемното сандаче. Именувајте ја папката во која вашето правило за пошта ги става пораките за работа."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Препознаено"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Безбедност"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Сервер"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Најавата е одбиена. Проверете ги корисничкото име и лозинката."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Најавено, но нема папка наречена „%(folder)s“."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Најавено, но овој сервер не може да преместува пораки. Наместо тоа, изберете да се означуваат со знаменце."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Најавено. %(count)d порака во „%(folder)s“ чека да биде прочитана."
msgstr[1] "Најавено. %(count)d пораки во „%(folder)s“ чекаат да бидат прочитани."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (порта 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Потпапка"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "адресата на контакт"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "името на компанијата во пораката"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Папката „%(folder)s“ не можеше да се отвори."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Поштенското сандаче го одби пребарувањето."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Поштенското сандаче одби да ги предаде пораките."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Поштенското сандаче одби да ја побара папката."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Пораките беа прочитани, но не можеа да се означат со знаменце; при следното поминување ќе бидат повторно прочитани."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Пораките беа прочитани, но не можеа да се преместат во „%(folder)s“; при следното поминување ќе бидат повторно прочитани."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Пораките беа прочитани, но овој сервер не може да ги премести; при следното поминување ќе бидат повторно прочитани."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "називот на работното место во пораката"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "веб-доменот на испраќачот"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr ""

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (порта 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Се користи само кога пораките се преместуваат. Се создава ако недостасува."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Корисничко име"
