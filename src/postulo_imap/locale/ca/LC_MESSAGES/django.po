#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d missatge no s'ha pogut associar a cap candidatura; adjunteu-lo a mà."
msgstr[1] "%(count)d missatges no s'han pogut associar a cap candidatura; adjunteu-los a mà."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d missatge no s'ha pogut llegir i s'ha omès."
msgstr[1] "%(count)d missatges no s'han pogut llegir i s'han omès."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Un missatge sense assumpte"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "un rebuig"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "una resposta a un missatge ja associat"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "un acusament de recepció"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Una contrasenya d'aplicació, si el servidor n'ofereix; Gmail l'exigeix si teniu activada l'autenticació de dos factors. Es desa xifrada."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "una avaluació"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "una invitació"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "una proposta de feina"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "No s'ha pogut connectar amb el servidor. Comproveu l'adreça, el port i la seguretat."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Marca'l amb %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "El marcatge és invisible en la majoria de clients i fa que cada passada sigui breu. Si es deixa la bústia intacta, una passada només llegeix els missatges arribats des de l'anterior; en tots dos casos no se suggereix res dues vegades."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Carpeta que cal llegir"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Per exemple, imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "De"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Indiqueu un nombre de dies entre 1 i %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Indiqueu un port entre 1 i 65535, o deixeu-lo buit."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Quants dies de correu té en compte cada passada."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Deixa la bústia sense tocar"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Si es deixa buit: 993 amb TLS, 143 amb STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Dies enrere"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Bústia (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Associat per"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Mou-lo a una subcarpeta"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Indiqueu una subcarpeta diferent de la carpeta que es llegeix."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Indiqueu la carpeta que cal llegir. Postulo no llegeix mai la safata d'entrada."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Indiqueu la subcarpeta on s'han de moure els missatges."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "encara res"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Un cop llegit"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Una carpeta, mai la safata d'entrada. Creeu una regla al vostre servidor de correu que arxivi aquí el correu dels reclutadors; Postulo no llegeix res més. Cada missatge que llegeix es marca o es mou després, tant si s'ha reconegut com si no."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Contrasenya o contrasenya d'aplicació"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo no llegeix mai la safata d'entrada. Indiqueu la carpeta on la vostra regla de correu arxiva el correu de feina."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Reconegut"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Seguretat"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Servidor"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "S'ha rebutjat l'inici de sessió. Comproveu el nom d'usuari i la contrasenya."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "S'ha iniciat la sessió, però no hi ha cap carpeta anomenada «%(folder)s»."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "S'ha iniciat la sessió, però aquest servidor no pot moure missatges. Trieu marcar-los en lloc d'això."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "S'ha iniciat la sessió. %(count)d missatge de «%(folder)s» està pendent de llegir."
msgstr[1] "S'ha iniciat la sessió. %(count)d missatges de «%(folder)s» estan pendents de llegir."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Subcarpeta"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "l'adreça d'un contacte"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "el nom de l'empresa al missatge"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "No s'ha pogut obrir la carpeta «%(folder)s»."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "La bústia ha rebutjat la cerca."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "La bústia s'ha negat a lliurar els missatges."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "La bústia s'ha negat a cercar la carpeta."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Els missatges s'han llegit, però no s'han pogut marcar; la propera passada els tornarà a llegir."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Els missatges s'han llegit, però no s'han pogut moure a «%(folder)s»; la propera passada els tornarà a llegir."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Els missatges s'han llegit, però aquest servidor no els pot moure; la propera passada els tornarà a llegir."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "el títol del lloc de treball al missatge"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "el domini web del remitent"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Aquesta carpeta no conserva marques pròpies, de manera que Postulo recorda on ha acabat l'última passada en lloc de marcar el que ha llegit."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Només es fa servir quan es mouen els missatges. Es crea si no existeix."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Nom d'usuari"
