#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d նամակ հնարավոր չեղավ կապել որևէ դիմումի հետ․ կցեք այն ձեռքով։"
msgstr[1] "%(count)d նամակ հնարավոր չեղավ կապել որևէ դիմումի հետ․ կցեք դրանք ձեռքով։"

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d նամակ հնարավոր չեղավ կարդալ, և այն բաց թողնվեց։"
msgstr[1] "%(count)d նամակ հնարավոր չեղավ կարդալ, և դրանք բաց թողնվեցին։"

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Առանց թեմայի հաղորդագրություն"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "մերժում"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "պատասխան արդեն համապատասխանեցված նամակին"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "ստացման հաստատում"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Հավելվածի գաղտնաբառ, եթե սերվերն այն առաջարկում է․ Gmail-ը այն պահանջում է, երբ երկգործոն նույնականացումը միացված է։ Պահվում է գաղտնագրված։"

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "գնահատում"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "հրավեր"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "առաջարկ"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Չհաջողվեց կապ հաստատել սերվերի հետ։ Ստուգեք հասցեն, պորտը և անվտանգության կարգավորումը։"

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Նշել %(keyword)s բանալի բառով"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Նշումը տեսանելի չէ փոստային ծրագրերի մեծ մասում և ամեն անցումը կարճ է պահում։ Եթե փոստարկղն անփոփոխ թողնեք, յուրաքանչյուր վերջին հաղորդագրություն նորից կկարդացվի․ երկու դեպքում էլ ոչինչ երկու անգամ չի առաջարկվում։"

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Կարդալու թղթապանակ"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Օրինակ՝ imap.example.org։"

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Ումից"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Նշեք օրերի թիվ 1-ի և %(max)d-ի միջև։"

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Նշեք պորտ 1-ի և 65535-ի միջև կամ թողեք դատարկ։"

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Քանի օրվա փոստ է դիտարկում յուրաքանչյուր անցում։"

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Թողնել փոստարկղն անփոփոխ"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Դատարկ թողնելու դեպքում՝ 993 TLS-ով, 143 STARTTLS-ով։"

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Քանի օր հետ նայել"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Փոստարկղ (IMAP)"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Matched by"
msgstr "Համապատասխանեցվել է՝"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Տեղափոխել ենթաթղթապանակ"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Նշեք ենթաթղթապանակ, որը տարբերվում է կարդացվող թղթապանակից։"

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Նշեք կարդալու թղթապանակը։ Postulo-ն երբեք չի կարդում մուտքի արկղը։"

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Նշեք ենթաթղթապանակը, որտեղ պետք է տեղափոխվեն հաղորդագրությունները։"

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "դեռ ոչինչ"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Կարդալուց հետո"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Մեկ թղթապանակ, երբեք մուտքի արկղը։ Ձեր փոստի սերվերում ստեղծեք կանոն, որը հավաքագրողների նամակները դասում է այստեղ․ Postulo-ն ուրիշ ոչինչ չի կարդում։ Յուրաքանչյուր նամակ, որ այն կարդում է, հետո նշվում կամ տեղափոխվում է՝ անկախ նրանից՝ ճանաչվել է, թե ոչ։"

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Գաղտնաբառ կամ հավելվածի գաղտնաբառ"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Պորտ"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo-ն երբեք չի կարդում մուտքի արկղը։ Նշեք այն թղթապանակը, որտեղ ձեր փոստի կանոնը դասում է աշխատանքի մասին նամակները։"

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Ճանաչված"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Անվտանգություն"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Սերվեր"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Մուտքը մերժվեց։ Ստուգեք օգտանունը և գաղտնաբառը։"

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Մուտքը կատարվեց, բայց «%(folder)s» անունով թղթապանակ չկա։"

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Մուտքը կատարված է, բայց այս սերվերը չի կարող նամակներ տեղափոխել։ Փոխարենը ընտրեք դրանք նշելը։"

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Մուտքը կատարված է։ «%(folder)s» թղթապանակում %(count)d նամակ սպասում է կարդացվելու։"
msgstr[1] "Մուտքը կատարված է։ «%(folder)s» թղթապանակում %(count)d նամակ սպասում են կարդացվելու։"

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (պորտ 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Ենթաթղթապանակ"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "կոնտակտի հասցեն"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "ընկերության անունը նամակում"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "«%(folder)s» թղթապանակը հնարավոր չեղավ բացել։"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Փոստարկղը մերժեց որոնումը։"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Փոստարկղը հրաժարվեց տրամադրել հաղորդագրությունները։"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Փոստարկղը հրաժարվեց փնտրել թղթապանակը։"

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Նամակները կարդացվեցին, բայց հնարավոր չեղավ դրանք նշել․ հաջորդ անցումը կրկին կկարդա դրանք։"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Նամակները կարդացվեցին, բայց հնարավոր չեղավ դրանք տեղափոխել «%(folder)s» թղթապանակ․ հաջորդ անցումը կրկին կկարդա դրանք։"

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Նամակները կարդացվեցին, բայց այս սերվերը չի կարող դրանք տեղափոխել․ հաջորդ անցումը կրկին կկարդա դրանք։"

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "պաշտոնի անվանումը նամակում"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "ուղարկողի վեբ տիրույթը"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "This folder does not keep flags of its own, so every message of the look-back is read again on each pass."
msgstr "Այս թղթապանակը սեփական նշումներ չի պահում, ուստի դիտարկվող ժամանակահատվածի յուրաքանչյուր նամակ կրկին կարդացվում է ամեն անցման ժամանակ։"

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (պորտ 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Օգտագործվում է միայն հաղորդագրությունները տեղափոխելիս։ Ստեղծվում է, եթե չկա։"

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Օգտանուն"
