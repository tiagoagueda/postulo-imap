#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d tidak dapat dicocokkan dengan lamaran; lampirkan secara manual."

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d pesan tidak dapat dibaca dan dilewati."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Pesan tanpa subjek"

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "a rejection"
msgstr "penolakan"

#: src/postulo_imap/matching.py
#, fuzzy
msgid "a reply to a message already matched"
msgstr "balasan ke pesan yang sudah cocok"

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an acknowledgement"
msgstr "sebuah pengakuan"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Kata sandi aplikasi, di mana pun server menyediakannya; Gmail mewajibkannya bila autentikasi dua faktor aktif. Disimpan terenkripsi."

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an assessment"
msgstr "sebuah penilaian"

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an invitation"
msgstr "undangan"

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an offer"
msgstr "sebuah tawaran"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Tidak dapat menjangkau server. Periksa alamat, port, dan keamanannya."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Tandai dengan %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Penandaan tidak terlihat di sebagian besar klien email dan membuat setiap putaran tetap singkat. Membiarkan kotak surat apa adanya berarti setiap pesan terbaru dibaca lagi; dengan cara mana pun, tidak ada yang disarankan dua kali."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Folder untuk dibaca"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Misalnya imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Dari"

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Berikan beberapa hari antara 1 dan %(max)d."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Berikan port antara 1 dan 65535, atau biarkan kosong."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Berapa hari surat yang diperiksa dalam setiap putaran."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Biarkan kotak surat apa adanya"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Kiri kosong: 993 dengan TLS, 143 dengan STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Rentang waktu"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Kotak surat (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Dicocokkan oleh"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Pindahkan ke subfolder"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Name a subfolder other than the folder being read."
msgstr "Nama subfolder selain folder yang sedang dibaca."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Sebutkan nama folder yang akan dibaca. Postulo tidak pernah membaca kotak masuk."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Sebutkan nama subfolder tujuan pemindahan pesan."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "belum ada"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Setelah dibaca"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Satu folder, tidak pernah kotak masuk. Membuat aturan pada server surat Anda bahwa file perekrut surat di sini; Postulo tidak membaca apa-apa lagi. Setiap pesan yang dibaca ditandai atau dipindahkan setelah itu, apakah itu diakui atau tidak."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Kata sandi atau kata sandi aplikasi"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo tidak pernah membaca inbox. Nama folder tempat Anda membuat berkas berkas tugas."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Dikenali"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Keamanan"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Server"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Proses masuk ditolak. Periksa nama pengguna dan kata sandi."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Sudah masuk, tetapi tidak ada folder bernama “%(folder)s”."

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Ditandatangani, tapi server ini tidak dapat memindah pesan. Pilih untuk bendera mereka sebagai gantinya."

#: src/postulo_imap/sync.py
#, fuzzy, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Ditandatangani masuk %(count)d pesan dalam \"%(folder)s\" sedang menunggu untuk dibaca."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Subfolder"

#: src/postulo_imap/matching.py
#, fuzzy
msgid "the address of a contact"
msgstr "alamat kontak"

#: src/postulo_imap/matching.py
#, fuzzy
msgid "the company’s name in the message"
msgstr "nama perusahaan dalam pesan"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Folder “%(folder)s” tidak dapat dibuka."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Kotak surat menolak pencarian."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Kotak surat menolak untuk menyerahkan pesan."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "The mailbox refused to look for the folder."
msgstr "Kotak-surat menolak untuk mencari folder."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Pesan-pesan yang dibaca tapi tidak bisa ditandai; lulus berikutnya akan membacanya lagi."

#: src/postulo_imap/mailbox.py
#, fuzzy, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Pesan-pesan yang dibaca tapi tidak dapat dipindahkan ke \"%(folder)s\"; lulus berikutnya akan membacanya lagi."

#: src/postulo_imap/mailbox.py
#, fuzzy
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Pesan-pesan yang dibaca, tapi server ini tidak dapat memindahkannya; lewat berikutnya akan membacanya lagi."

#: src/postulo_imap/matching.py
#, fuzzy
msgid "the role’s title in the message"
msgstr "judul peran dalam pesan"

#: src/postulo_imap/matching.py
#, fuzzy
msgid "the sender’s web domain"
msgstr "domain web pengirim"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "This folder does not keep flags of its own, so every message of the look-back is read again on each pass."
msgstr "Folder ini tidak menyimpan bendera sendiri, jadi setiap pesan dari lookin-back dibaca lagi di setiap tahap."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Hanya digunakan saat pesan dipindahkan. Dibuat jika belum ada."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Nama pengguna"
