#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)dটি কোনো আবেদনের সঙ্গে মেলানো যায়নি; এটি হাতে সংযুক্ত করুন।"
msgstr[1] "%(count)dটি কোনো আবেদনের সঙ্গে মেলানো যায়নি; সেগুলো হাতে সংযুক্ত করুন।"

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)dটি বার্তা পড়া যায়নি এবং বাদ দেওয়া হয়েছে।"
msgstr[1] "%(count)dটি বার্তা পড়া যায়নি এবং বাদ দেওয়া হয়েছে।"

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "বিষয়হীন একটি বার্তা"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "একটি প্রত্যাখ্যান"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "ইতিমধ্যে মেলানো একটি বার্তার উত্তর"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "একটি প্রাপ্তিস্বীকার"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "সার্ভার যেখানে অ্যাপ পাসওয়ার্ড দেয়, সেখানে একটি অ্যাপ পাসওয়ার্ড; দুই-ধাপের যাচাইকরণ চালু থাকলে Gmail এটি আবশ্যক করে। এনক্রিপ্ট করে সংরক্ষণ করা হয়।"

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "একটি মূল্যায়ন"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "একটি আমন্ত্রণ"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "একটি প্রস্তাব"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "সার্ভারে পৌঁছানো যায়নি। সার্ভারের ঠিকানা, পোর্ট এবং নিরাপত্তা যাচাই করুন।"

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "%(keyword)s দিয়ে চিহ্নিত করুন"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "বেশির ভাগ ক্লায়েন্টে ফ্ল্যাগ চোখে পড়ে না এবং এতে প্রতিটি পাস ছোট থাকে। মেলবক্স অপরিবর্তিত রাখলে প্রতিটি পাস শুধু গত পাসের পরে আসা বার্তাগুলো পড়ে; দুই ক্ষেত্রেই কিছু দুবার প্রস্তাব করা হয় না।"

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "যে ফোল্ডার পড়া হবে"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "যেমন imap.example.org।"

#: src/postulo_imap/sync.py
msgid "From"
msgstr "প্রেরক"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "1 থেকে %(max)d-এর মধ্যে দিনের একটি সংখ্যা দিন।"

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "1 থেকে 65535-এর মধ্যে একটি পোর্ট দিন, অথবা খালি রাখুন।"

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "প্রতিবার চালানোর সময় কত দিনের মেল বিবেচনা করা হয়।"

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "মেলবক্স অপরিবর্তিত রাখুন"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "খালি রাখলে: TLS-সহ 993, STARTTLS-সহ 143।"

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "কত দিন পেছনে দেখা হবে"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "মেলবক্স (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "মেলানোর ভিত্তি"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "একটি সাবফোল্ডারে সরিয়ে নিন"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "যে ফোল্ডারটি পড়া হচ্ছে সেটি ছাড়া অন্য একটি সাবফোল্ডারের নাম দিন।"

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "যে ফোল্ডার পড়া হবে তার নাম দিন। Postulo কখনো ইনবক্স পড়ে না।"

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "যে সাবফোল্ডারে বার্তাগুলো সরিয়ে নেওয়া হবে তার নাম দিন।"

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "এখনো কিছুই না"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "পড়া হয়ে গেলে"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "একটি ফোল্ডার, কখনও ইনবক্স নয়। আপনার মেল সার্ভারে একটি নিয়ম তৈরি করুন যা নিয়োগকারীদের মেল এখানে রাখে; Postulo আর কিছুই পড়ে না। এটি যে বার্তাই পড়ে, চেনা যাক বা না যাক, পরে তা ফ্ল্যাগ করা হয় বা সরানো হয়।"

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "পাসওয়ার্ড বা অ্যাপ পাসওয়ার্ড"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "পোর্ট"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo কখনও ইনবক্স পড়ে না। আপনার মেল নিয়ম চাকরি-সংক্রান্ত মেল যে ফোল্ডারে রাখে তার নাম দিন।"

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "শনাক্ত করা হয়েছে"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "নিরাপত্তা"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "সার্ভার"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "সাইন ইন প্রত্যাখ্যান করা হয়েছে। ব্যবহারকারীর নাম ও পাসওয়ার্ড যাচাই করুন।"

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "সাইন ইন করা হয়েছে, কিন্তু “%(folder)s” নামে কোনো ফোল্ডার নেই।"

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "সাইন ইন হয়েছে, কিন্তু এই সার্ভার বার্তা সরাতে পারে না। এর বদলে সেগুলো ফ্ল্যাগ করার বিকল্প বেছে নিন।"

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "সাইন ইন হয়েছে। “%(folder)s”-এ %(count)dটি বার্তা পড়ার অপেক্ষায় আছে।"
msgstr[1] "সাইন ইন হয়েছে। “%(folder)s”-এ %(count)dটি বার্তা পড়ার অপেক্ষায় আছে।"

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (পোর্ট 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "সাবফোল্ডার"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "কোনো পরিচিতির ঠিকানা"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "বার্তায় কোম্পানির নাম"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "“%(folder)s” ফোল্ডারটি খোলা যায়নি।"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "মেলবক্স অনুসন্ধানটি প্রত্যাখ্যান করেছে।"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "মেলবক্স বার্তাগুলো দিতে অস্বীকার করেছে।"

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "মেলবক্স ফোল্ডারটি খুঁজতে অস্বীকার করেছে।"

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "বার্তাগুলো পড়া হয়েছে কিন্তু ফ্ল্যাগ করা যায়নি; পরের বার চালানোর সময় সেগুলো আবার পড়া হবে।"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "বার্তাগুলো পড়া হয়েছে কিন্তু “%(folder)s”-এ সরানো যায়নি; পরের বার চালানোর সময় সেগুলো আবার পড়া হবে।"

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "বার্তাগুলো পড়া হয়েছে, কিন্তু এই সার্ভার সেগুলো সরাতে পারে না; পরের বার চালানোর সময় সেগুলো আবার পড়া হবে।"

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "বার্তায় পদের নাম"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "প্রেরকের ওয়েব ডোমেইন"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "এই ফোল্ডার নিজের ফ্ল্যাগ রাখে না, তাই পড়া বার্তায় ফ্ল্যাগ দেওয়ার বদলে Postulo মনে রাখে গত পাস কোথায় থেমেছিল।"

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (পোর্ট 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "কেবল বার্তা সরিয়ে নেওয়া হলে ব্যবহার করা হয়। না থাকলে তৈরি করা হয়।"

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "ব্যবহারকারীর নাম"
