#: src/postulo_imap/sync.py:221
#, python-format, draft
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr "%(count)d δεν ταίριαξαν με καμία αίτηση· επισυνάψτε τα με το χέρι."

#: src/postulo_imap/sync.py:194
#, draft
msgid "A message with no subject"
msgstr "Ένα μήνυμα χωρίς θέμα"

#: src/postulo_imap/sync.py:65
#, draft
msgid ""
"An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr ""
"Κωδικός εφαρμογής όπου ο διακομιστής προσφέρει έναν· το Gmail τον απαιτεί με ενεργή ταυτοποίηση δύο παραγόντων. Αποθηκεύεται κρυπτογραφημένος."

#: src/postulo_imap/sync.py:88
#, python-format, draft
msgid "Flag it with %(keyword)s"
msgstr "Σήμανση με %(keyword)s"

#: src/postulo_imap/sync.py:94
#, draft
msgid ""
"Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr ""
"Η σήμανση είναι αόρατη στα περισσότερα προγράμματα και κρατά κάθε πέρασμα σύντομο. Αν το γραμματοκιβώτιο μείνει ανέγγιχτο, κάθε πρόσφατο μήνυμα διαβάζεται ξανά· έτσι κι αλλιώς τίποτα δεν προτείνεται δύο φορές."

#: src/postulo_imap/sync.py:73
#, draft
msgid "Folder to read"
msgstr "Φάκελος προς ανάγνωση"

#: src/postulo_imap/sync.py:45
#, draft
msgid "For example imap.example.org."
msgstr "Για παράδειγμα imap.example.org."

#: src/postulo_imap/sync.py:200
#, draft
msgid "From"
msgstr "Από"

#: src/postulo_imap/sync.py:115
#, draft
msgid "How many days of mail a pass considers."
msgstr "Πόσες ημέρες αλληλογραφίας εξετάζει ένα πέρασμα."

#: src/postulo_imap/sync.py:90
#, draft
msgid "Leave the mailbox untouched"
msgstr "Να μείνει το γραμματοκιβώτιο ανέγγιχτο"

#: src/postulo_imap/sync.py:111
#, draft
msgid "Look back"
msgstr "Αναδρομή"

#: src/postulo_imap/sync.py:40
#, draft
msgid "Mailbox (IMAP)"
msgstr "Γραμματοκιβώτιο (IMAP)"

#: src/postulo_imap/sync.py:201
#, draft
msgid "Matched by"
msgstr "Ταίριασμα μέσω"

#: src/postulo_imap/sync.py:89
#, draft
msgid "Move it to a subfolder"
msgstr "Μετακίνηση σε υποφάκελο"

#: src/postulo_imap/sync.py:128
#, draft
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr ""
"Ονομάστε τον φάκελο προς ανάγνωση. Το Postulo δεν διαβάζει ποτέ τα εισερχόμενα."

#: src/postulo_imap/sync.py:126
#, draft
msgid "Name the subfolder to move messages to."
msgstr "Ονομάστε τον υποφάκελο στον οποίο μετακινούνται τα μηνύματα."

#: src/postulo_imap/sync.py:201
#, draft
msgid "nothing yet"
msgstr "τίποτα ακόμη"

#: src/postulo_imap/sync.py:85
#, draft
msgid "Once read"
msgstr "Μετά την ανάγνωση"

#: src/postulo_imap/sync.py:77
#, draft
msgid ""
"One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else."
msgstr ""
"Ένας φάκελος, ποτέ τα εισερχόμενα. Φτιάξτε έναν κανόνα στον διακομιστή αλληλογραφίας σας που να αρχειοθετεί εδώ τα μηνύματα των recruiter· το Postulo δεν διαβάζει τίποτα άλλο."

#: src/postulo_imap/sync.py:61
#, draft
msgid "Password or app password"
msgstr "Κωδικός πρόσβασης ή κωδικός εφαρμογής"

#: src/postulo_imap/sync.py:47
#, draft
msgid "Port"
msgstr "Θύρα"

#: src/postulo_imap/sync.py:203
#, draft
msgid "Recognised"
msgstr "Αναγνωρίστηκαν"

#: src/postulo_imap/sync.py:50
#, draft
msgid "Security"
msgstr "Ασφάλεια"

#: src/postulo_imap/sync.py:45
#, draft
msgid "Server"
msgstr "Διακομιστής"

#: src/postulo_imap/sync.py:143
#, python-format, draft
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Έγινε σύνδεση, αλλά δεν υπάρχει φάκελος με όνομα «%(folder)s»."

#: src/postulo_imap/sync.py:158
#, python-format, draft
msgid "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr ""
"Έγινε σύνδεση. %(count)d μηνύματα στον φάκελο «%(folder)s» περιμένουν να διαβαστούν."

#: src/postulo_imap/sync.py:54
#, draft
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (θύρα 143)"

#: src/postulo_imap/sync.py:103
#, draft
msgid "Subfolder"
msgstr "Υποφάκελος"

#: src/postulo_imap/sync.py:53
#, draft
msgid "TLS (port 993)"
msgstr "TLS (θύρα 993)"

#: src/postulo_imap/sync.py:107
#, draft
msgid "Used only when messages are moved. Created if missing."
msgstr ""
"Χρησιμοποιείται μόνο όταν μετακινούνται μηνύματα. Δημιουργείται αν λείπει."

#: src/postulo_imap/sync.py:58
#, draft
msgid "Username"
msgstr "Όνομα χρήστη"
