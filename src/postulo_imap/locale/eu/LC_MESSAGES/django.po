#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "Mezu bat ezin izan da hautagaitza batekin lotu; erantsi eskuz."
msgstr[1] "%(count)d mezu ezin izan dira hautagaitza batekin lotu; erantsi eskuz."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "Mezu bat ezin izan da irakurri, eta saltatu egin da."
msgstr[1] "%(count)d mezu ezin izan dira irakurri, eta saltatu egin dira."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Gairik gabeko mezua"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "ezespen bat"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "jada lotutako mezu baten erantzuna"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "jasotze-agiri bat"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Aplikazio-pasahitz bat, zerbitzariak eskaintzen duen guztietan; Gmail-ek derrigorrezkoa du bi faktoreko autentifikazioa piztuta dagoenean. Zifratuta gordetzen da."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "ebaluazio bat"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "gonbidapen bat"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "eskaintza bat"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Ezin izan da zerbitzarira iritsi. Egiaztatu helbidea, ataka eta segurtasuna."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Markatu %(keyword)s gako-hitzarekin"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "Markatzea ikusezina da bezero gehienetan eta irakurraldi bakoitza laburra mantentzen du. Postontzia ukitu gabe uzteak esan nahi du irakurraldi batek azkenaren ondoren iritsi diren mezuak soilik irakurtzen dituela; bi kasuetan ez da ezer bi aldiz iradokitzen."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Irakurtzeko karpeta"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Adibidez, imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Igorlea"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Eman 1 eta %(max)d arteko egun kopurua."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Eman 1 eta 65535 arteko ataka bat, edo utzi hutsik."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Irakurraldi batek zenbat eguneko posta hartzen duen kontuan."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Utzi postontzia ukitu gabe"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Hutsik utzita: 993 TLS erabiliz, 143 STARTTLS erabiliz."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Atzera begiratzeko egunak"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Postontzia (IMAP)"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Matched by"
msgstr "Lotzeko irizpidea"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Eraman azpikarpetara"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Idatzi irakurtzen den karpeta ez den beste azpikarpeta baten izena."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Idatzi irakurri beharreko karpetaren izena. Postulok ez du inoiz sarrerako ontzia irakurtzen."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Idatzi mezuak eramateko azpikarpetaren izena."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "ezer ez oraindik"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Behin irakurrita"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Karpeta bat, inoiz ez sarrerako ontzia. Sortu arau bat zure posta-zerbitzarian kontratatzaileen mezuak hemen artxibatzeko; Postulok ez du beste ezer irakurtzen. Irakurtzen duen mezu oro markatu edo lekuz aldatu egiten da ondoren, ezagutu den ala ez."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Pasahitza edo aplikazio-pasahitza"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Ataka"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulok ez du inoiz sarrerako ontzia irakurtzen. Idatzi zure posta-arauak lan-mezuak artxibatzen dituen karpetaren izena."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Ezagututa"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Segurtasuna"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Zerbitzaria"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Saioa hastea ukatu da. Egiaztatu erabiltzaile-izena eta pasahitza."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Saioa hasi da, baina ez dago «%(folder)s» izeneko karpetarik."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Saioa hasi da, baina zerbitzari honek ezin ditu mezuak lekuz aldatu. Aukeratu markatzea horren ordez."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Saioa hasi da. «%(folder)s» karpetako mezu bat irakurtzeko zain dago."
msgstr[1] "Saioa hasi da. «%(folder)s» karpetako %(count)d mezu irakurtzeko zain daude."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (143 ataka)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Azpikarpeta"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "kontaktu baten helbidea"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "enpresaren izena mezuan"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Ezin izan da «%(folder)s» karpeta ireki."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Postontziak bilaketa ukatu zuen."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Postontziak uko egin dio mezuak emateari."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Postontziak karpeta bilatzeari uko egin zion."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Mezuak irakurri dira, baina ezin izan dira markatu; hurrengo irakurraldian berriro irakurriko dira."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Mezuak irakurri dira, baina ezin izan dira «%(folder)s» karpetara eraman; hurrengo irakurraldian berriro irakurriko dira."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Mezuak irakurri dira, baina zerbitzari honek ezin ditu lekuz aldatu; hurrengo irakurraldian berriro irakurriko dira."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "mezuko lanpostuaren izena"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "igorlearen web-domeinua"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Karpeta honek ez ditu bere markak gordetzen, beraz Postulok irakurraldiak non gelditu zen gogoratzen du, irakurritakoa markatu beharrean."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (993 ataka)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Mezuak lekuz aldatzen direnean soilik erabiltzen da. Ez badago, sortu egiten da."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Erabiltzaile-izena"
