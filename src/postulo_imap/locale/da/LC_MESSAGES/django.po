#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d kunne ikke matches med en ansøgning; tilknyt den manuelt."
msgstr[1] "%(count)d kunne ikke matches med en ansøgning; tilknyt dem manuelt."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d besked kunne ikke læses og blev sprunget over."
msgstr[1] "%(count)d beskeder kunne ikke læses og blev sprunget over."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "En besked uden emne"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "en afvisning"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "et svar på en besked, der allerede er matchet"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "en kvittering for modtagelse"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "En app-adgangskode, hvor serveren tilbyder en; Gmail kræver det med tofaktorgodkendelse slået til. Gemmes krypteret."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "en test eller vurdering"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "en invitation"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "et tilbud"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Kunne ikke nå serveren. Tjek adressen, porten og sikkerheden."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Markér den med %(keyword)s"

#: src/postulo_imap/sync.py
#, fuzzy
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr "Markering med flag er usynlig i de fleste klienter og holder hver gennemgang kort. Hvis postkassen lades uberørt, læser en gennemgang kun de meddelelser, der er kommet siden den forrige; intet foreslås to gange i begge tilfælde."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Mappe, der skal læses"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "For eksempel imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Fra"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Angiv et antal dage mellem 1 og %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Angiv en port mellem 1 og 65535, eller lad feltet stå tomt."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Hvor mange dages post en gennemgang tager med."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Lad postkassen være urørt"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Hvis tomt: 993 med TLS, 143 med STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Se tilbage"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Postkasse (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Matchet på"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Flyt den til en undermappe"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Angiv en anden undermappe end den mappe, der læses."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Angiv mappen, der skal læses. Postulo læser aldrig indbakken."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Angiv undermappen, som beskeder skal flyttes til."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "intet endnu"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Efter læsning"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Én mappe, aldrig indbakken. Lav en regel på din mailserver, der sorterer mails fra rekrutterere hertil; Postulo læser intet andet. Hver besked, den læser, markeres eller flyttes bagefter, uanset om den blev genkendt eller ej."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Adgangskode eller app-adgangskode"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo læser aldrig indbakken. Angiv den mappe, din mailregel sorterer jobmails ind i."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Genkendt"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Sikkerhed"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Server"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Login afvist. Tjek brugernavnet og adgangskoden."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Logget ind, men der er ingen mappe ved navn »%(folder)s«."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Logget ind, men denne server kan ikke flytte beskeder. Vælg i stedet at markere dem."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Logget ind. %(count)d besked i »%(folder)s« venter på at blive læst."
msgstr[1] "Logget ind. %(count)d beskeder i »%(folder)s« venter på at blive læst."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Undermappe"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "adressen på en kontakt"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "virksomhedens navn i beskeden"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Mappen »%(folder)s« kunne ikke åbnes."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Postkassen afviste søgningen."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Postkassen nægtede at udlevere beskederne."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Postkassen nægtede at lede efter mappen."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Beskederne blev læst, men kunne ikke markeres; næste gennemgang læser dem igen."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Beskederne blev læst, men kunne ikke flyttes til »%(folder)s«; næste gennemgang læser dem igen."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Beskederne blev læst, men denne server kan ikke flytte dem; næste gennemgang læser dem igen."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "stillingsbetegnelsen i beskeden"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "afsenderens webdomæne"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr "Denne mappe har ikke egne flag, så Postulo husker, hvor den forrige gennemgang stoppede, i stedet for at sætte flag på det, den læste."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Bruges kun, når beskeder flyttes. Oprettes, hvis den mangler."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Brugernavn"
