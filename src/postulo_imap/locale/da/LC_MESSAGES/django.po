msgstr "Postkasse (IMAP)"

#: src/postulo_imap/sync.py:201
#, draft
msgid "Matched by"
msgstr "Matchet på"

#: src/postulo_imap/sync.py:89
#, draft
msgid "Move it to a subfolder"
msgstr "Flyt den til en undermappe"

#: src/postulo_imap/sync.py:128
#, draft
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Angiv mappen, der skal læses. Postulo læser aldrig indbakken."

#: src/postulo_imap/sync.py:126
#, draft
msgid "Name the subfolder to move messages to."
msgstr "Angiv undermappen, som beskeder skal flyttes til."

#: src/postulo_imap/sync.py:201
#, draft
msgid "nothing yet"
msgstr "intet endnu"

#: src/postulo_imap/sync.py:85
#, draft
msgid "Once read"
msgstr "Når læst"

#: src/postulo_imap/sync.py:77
#, draft
msgid ""
"One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else."
msgstr ""
"Én mappe, aldrig indbakken. Lav en regel på din mailserver, der lægger rekrutteringsmail her; Postulo læser intet andet."

