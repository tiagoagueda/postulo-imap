#: src/postulo_imap/sync.py:221
#, python-format, draft
msgid "%(count)d could not be matched to an application; attach them by hand."
msgstr ""
"%(count)d non hanno potuto essere associati a una candidatura; allegali a mano."

#: src/postulo_imap/sync.py:194
#, draft
msgid "A message with no subject"
msgstr "Un messaggio senza oggetto"

#: src/postulo_imap/sync.py:65
#, draft
msgid ""
"An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr ""
"Una password per le app dove il server la offre; Gmail la richiede con l'autenticazione a due fattori attiva. Salvata cifrata."

#: src/postulo_imap/sync.py:88
#, python-format, draft
msgid "Flag it with %(keyword)s"
msgstr "Contrassegnalo con %(keyword)s"

#: src/postulo_imap/sync.py:94
#, draft
msgid ""
"Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr ""
"Il contrassegno è invisibile nella maggior parte dei client e mantiene breve ogni passaggio. Lasciare intatta la casella significa rileggere ogni messaggio recente; in entrambi i casi nulla viene suggerito due volte."

#: src/postulo_imap/sync.py:73
#, draft
msgid "Folder to read"
msgstr "Cartella da leggere"

#: src/postulo_imap/sync.py:45
#, draft
msgid "For example imap.example.org."
msgstr "Ad esempio imap.example.org."

#: src/postulo_imap/sync.py:200
#, draft
msgid "From"
msgstr "Da"

#: src/postulo_imap/sync.py:115
#, draft
msgid "How many days of mail a pass considers."
msgstr "Quanti giorni di posta considera un passaggio."

#: src/postulo_imap/sync.py:90
#, draft
msgid "Leave the mailbox untouched"
msgstr "Lascia intatta la casella"

#: src/postulo_imap/sync.py:111
#, draft
msgid "Look back"
msgstr "Guarda indietro"

#: src/postulo_imap/sync.py:40
#, draft
msgid "Mailbox (IMAP)"
msgstr "Casella di posta (IMAP)"

#: src/postulo_imap/sync.py:201
#, draft
msgid "Matched by"
msgstr "Associato tramite"

#: src/postulo_imap/sync.py:89
#, draft
msgid "Move it to a subfolder"
msgstr "Spostalo in una sottocartella"

#: src/postulo_imap/sync.py:128
#, draft
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Indica la cartella da leggere. Postulo non legge mai la posta in arrivo."

#: src/postulo_imap/sync.py:126
#, draft
msgid "Name the subfolder to move messages to."
msgstr "Indica la sottocartella in cui spostare i messaggi."

#: src/postulo_imap/sync.py:201
#, draft
msgid "nothing yet"
msgstr "ancora nulla"

#: src/postulo_imap/sync.py:85
#, draft
msgid "Once read"
msgstr "Una volta letto"

#: src/postulo_imap/sync.py:77
#, draft
msgid ""
"One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else."
msgstr ""
"Una sola cartella, mai la posta in arrivo. Crea una regola sul tuo server di posta che archivi qui le mail dei recruiter; Postulo non legge altro."

#: src/postulo_imap/sync.py:61
#, draft
msgid "Password or app password"
msgstr "Password o password per le app"

#: src/postulo_imap/sync.py:47
#, draft
msgid "Port"
msgstr "Porta"

#: src/postulo_imap/sync.py:203
#, draft
msgid "Recognised"
msgstr "Riconosciuti"

#: src/postulo_imap/sync.py:50
#, draft
msgid "Security"
msgstr "Sicurezza"

#: src/postulo_imap/sync.py:45
#, draft
msgid "Server"
msgstr "Server"

#: src/postulo_imap/sync.py:143
#, python-format, draft
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Accesso riuscito, ma non c'è nessuna cartella chiamata «%(folder)s»."

#: src/postulo_imap/sync.py:158
#, python-format, draft
msgid "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr ""
"Accesso riuscito. %(count)d messaggi in «%(folder)s» aspettano di essere letti."

#: src/postulo_imap/sync.py:54
#, draft
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (porta 143)"

