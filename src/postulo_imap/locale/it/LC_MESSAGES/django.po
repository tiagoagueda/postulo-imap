#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d messaggio non è stato abbinato a una candidatura; collegalo a mano."
msgstr[1] "%(count)d messaggi non sono stati abbinati a una candidatura; collegali a mano."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d messaggio non è stato letto ed è stato saltato."
msgstr[1] "%(count)d messaggi non sono stati letti e sono stati saltati."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Un messaggio senza oggetto"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "un rifiuto"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "una risposta a un messaggio già abbinato"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "una conferma di ricezione"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Una password per le app dove il server la offre; Gmail la richiede con l'autenticazione a due fattori attiva. Salvata cifrata."

#: src/postulo_imap/classifying.py
msgid "an assessment"
msgstr "una valutazione"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "un invito"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "un'offerta"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Impossibile raggiungere il server. Controlla l'indirizzo, la porta e la sicurezza."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Contrassegnalo con %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means every recent message is read again; nothing is suggested twice either way."
msgstr "Il contrassegno è invisibile nella maggior parte dei client e mantiene breve ogni passaggio. Lasciare intatta la casella significa rileggere ogni messaggio recente; in entrambi i casi nulla viene suggerito due volte."

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Cartella da leggere"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Ad esempio imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Da"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Indica un numero di giorni tra 1 e %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Indica una porta tra 1 e 65535, oppure lascia vuoto."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Quanti giorni di posta considera un passaggio."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Lascia intatta la casella"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Se vuoto: 993 con TLS, 143 con STARTTLS."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Periodo a ritroso"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Casella di posta (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Abbinato tramite"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Spostalo in una sottocartella"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Indica una sottocartella diversa dalla cartella che viene letta."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Indica la cartella da leggere. Postulo non legge mai la posta in arrivo."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Indica la sottocartella in cui spostare i messaggi."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "ancora nulla"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Dopo la lettura"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Una sola cartella, mai la posta in arrivo. Crea una regola sul tuo server di posta che sposti qui la posta dei selezionatori; Postulo non legge nient'altro. Ogni messaggio letto viene poi contrassegnato o spostato, che sia stato riconosciuto o no."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Password o password per le app"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Porta"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo non legge mai la posta in arrivo. Indica la cartella in cui la tua regola di posta sposta i messaggi di lavoro."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Riconosciuti"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Sicurezza"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Server"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Accesso rifiutato. Controlla il nome utente e la password."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Accesso riuscito, ma non c'è nessuna cartella chiamata «%(folder)s»."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Accesso riuscito, ma questo server non può spostare i messaggi. Scegli invece di contrassegnarli."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Accesso riuscito. %(count)d messaggio in «%(folder)s» è in attesa di essere letto."
msgstr[1] "Accesso riuscito. %(count)d messaggi in «%(folder)s» sono in attesa di essere letti."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (porta 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Sottocartella"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "l'indirizzo di un contatto"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "il nome dell'azienda nel messaggio"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Non è stato possibile aprire la cartella «%(folder)s»."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "La casella di posta ha rifiutato la ricerca."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "La casella di posta ha rifiutato di consegnare i messaggi."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "La casella di posta ha rifiutato di cercare la cartella."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "I messaggi sono stati letti ma non è stato possibile contrassegnarli; il prossimo passaggio li leggerà di nuovo."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "I messaggi sono stati letti ma non è stato possibile spostarli in «%(folder)s»; il prossimo passaggio li leggerà di nuovo."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "I messaggi sono stati letti, ma questo server non può spostarli; il prossimo passaggio li leggerà di nuovo."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "il titolo del ruolo nel messaggio"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "il dominio web del mittente"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so every message of the look-back is read again on each pass."
msgstr "Questa cartella non conserva contrassegni propri, quindi ogni messaggio del periodo a ritroso viene riletto a ogni passaggio."

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (porta 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Usata solo quando i messaggi vengono spostati. Creata se manca."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Nome utente"
