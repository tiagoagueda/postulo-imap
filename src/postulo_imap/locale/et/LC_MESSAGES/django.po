#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d could not be matched to an application; attach it by hand."
msgid_plural "%(count)d could not be matched to an application; attach them by hand."
msgstr[0] "%(count)d kirja ei õnnestunud ühegi kandideerimisega siduda; lisage see käsitsi."
msgstr[1] "%(count)d kirja ei õnnestunud ühegi kandideerimisega siduda; lisage need käsitsi."

#: src/postulo_imap/sync.py
#, python-format
msgid "%(count)d message could not be read and was skipped."
msgid_plural "%(count)d messages could not be read and were skipped."
msgstr[0] "%(count)d kirja ei õnnestunud lugeda ja see jäeti vahele."
msgstr[1] "%(count)d kirja ei õnnestunud lugeda ja need jäeti vahele."

#: src/postulo_imap/sync.py
msgid "A message with no subject"
msgstr "Teemata kiri"

#: src/postulo_imap/classifying.py
msgid "a rejection"
msgstr "tagasilükkamine"

#: src/postulo_imap/matching.py
msgid "a reply to a message already matched"
msgstr "vastus juba seotud kirjale"

#: src/postulo_imap/classifying.py
msgid "an acknowledgement"
msgstr "kättesaamise kinnitus"

#: src/postulo_imap/sync.py
msgid "An app password wherever the server offers one; Gmail requires it with two-factor authentication on. Stored encrypted."
msgstr "Rakenduse parool, kui server seda pakub; Gmail nõuab seda, kui kaheastmeline autentimine on sees. Salvestatakse krüptitult."

#: src/postulo_imap/classifying.py
#, fuzzy
msgid "an assessment"
msgstr "hindamisülesanne"

#: src/postulo_imap/classifying.py
msgid "an invitation"
msgstr "kutse"

#: src/postulo_imap/classifying.py
msgid "an offer"
msgstr "pakkumine"

#: src/postulo_imap/mailbox.py
msgid "Could not reach the server. Check the address, the port and the security."
msgstr "Serveriga ei saanud ühendust. Kontrollige aadressi, porti ja turvaseadet."

#: src/postulo_imap/sync.py
#, python-format
msgid "Flag it with %(keyword)s"
msgstr "Märgistatakse lipuga %(keyword)s"

#: src/postulo_imap/sync.py
msgid "Flagging is invisible in most clients and keeps each pass short. Leaving the mailbox untouched means a pass reads only the messages that arrived since the last one; nothing is suggested twice either way."
msgstr ""

#: src/postulo_imap/sync.py
msgid "Folder to read"
msgstr "Loetav kaust"

#: src/postulo_imap/sync.py
msgid "For example imap.example.org."
msgstr "Näiteks imap.example.org."

#: src/postulo_imap/sync.py
msgid "From"
msgstr "Alates"

#: src/postulo_imap/sync.py
#, python-format
msgid "Give a number of days between 1 and %(max)d."
msgstr "Sisestage päevade arv vahemikus 1 kuni %(max)d."

#: src/postulo_imap/sync.py
msgid "Give a port between 1 and 65535, or leave it empty."
msgstr "Sisestage port vahemikus 1 kuni 65535 või jätke see tühjaks."

#: src/postulo_imap/sync.py
msgid "How many days of mail a pass considers."
msgstr "Mitme päeva kirju üks läbikäik arvestab."

#: src/postulo_imap/sync.py
msgid "Leave the mailbox untouched"
msgstr "Postkast jäetakse puutumata"

#: src/postulo_imap/sync.py
msgid "Left empty: 993 with TLS, 143 with STARTTLS."
msgstr "Tühjana: 993 TLS-iga, 143 STARTTLS-iga."

#: src/postulo_imap/sync.py
msgid "Look back"
msgstr "Vaadeldav periood"

#: src/postulo_imap/sync.py
msgid "Mailbox (IMAP)"
msgstr "Postkast (IMAP)"

#: src/postulo_imap/sync.py
msgid "Matched by"
msgstr "Sidumise alus"

#: src/postulo_imap/sync.py
msgid "Move it to a subfolder"
msgstr "Teisaldatakse alamkausta"

#: src/postulo_imap/sync.py
msgid "Name a subfolder other than the folder being read."
msgstr "Nimetage alamkaust, mis erineb loetavast kaustast."

#: src/postulo_imap/sync.py
msgid "Name the folder to read. Postulo never reads the inbox."
msgstr "Nimetage loetav kaust. Postulo ei loe kunagi sisendkausta."

#: src/postulo_imap/sync.py
msgid "Name the subfolder to move messages to."
msgstr "Nimetage alamkaust, kuhu kirjad teisaldatakse."

#: src/postulo_imap/sync.py
msgid "nothing yet"
msgstr "veel mitte midagi"

#: src/postulo_imap/sync.py
msgid "Once read"
msgstr "Pärast lugemist"

#: src/postulo_imap/sync.py
msgid "One folder, never the inbox. Make a rule on your mail server that files recruiter mail here; Postulo reads nothing else. Every message it reads is flagged or moved afterwards, whether or not it was recognised."
msgstr "Üks kaust, mitte kunagi sisendkaust. Looge oma e-posti serveris reegel, mis paigutab värbajate kirjad siia; Postulo ei loe midagi muud. Iga loetud kiri märgistatakse või teisaldatakse seejärel, olenemata sellest, kas see tuvastati või mitte."

#: src/postulo_imap/sync.py
msgid "Password or app password"
msgstr "Parool või rakenduse parool"

#: src/postulo_imap/sync.py
msgid "Port"
msgstr "Port"

#: src/postulo_imap/sync.py
msgid "Postulo never reads the inbox. Name the folder your mail rule files jobs mail into."
msgstr "Postulo ei loe kunagi sisendkausta. Nimetage kaust, kuhu teie e-posti reegel tööalased kirjad paigutab."

#: src/postulo_imap/sync.py
msgid "Recognised"
msgstr "Tuvastatud"

#: src/postulo_imap/sync.py
msgid "Security"
msgstr "Turvalisus"

#: src/postulo_imap/sync.py
msgid "Server"
msgstr "Server"

#: src/postulo_imap/mailbox.py
msgid "Sign-in refused. Check the username and the password."
msgstr "Sisselogimine lükati tagasi. Kontrollige kasutajanime ja parooli."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in, but there is no folder called “%(folder)s”."
msgstr "Sisse logitud, kuid kausta nimega „%(folder)s“ ei ole."

#: src/postulo_imap/sync.py
msgid "Signed in, but this server cannot move messages. Choose to flag them instead."
msgstr "Sisse logitud, kuid see server ei saa kirju teisaldada. Valige selle asemel lipuga märgistamine."

#: src/postulo_imap/sync.py
#, python-format
msgid "Signed in. %(count)d message in “%(folder)s” is waiting to be read."
msgid_plural "Signed in. %(count)d messages in “%(folder)s” are waiting to be read."
msgstr[0] "Sisse logitud. Kaustas „%(folder)s“ ootab lugemist %(count)d kiri."
msgstr[1] "Sisse logitud. Kaustas „%(folder)s“ ootab lugemist %(count)d kirja."

#: src/postulo_imap/sync.py
msgid "STARTTLS (port 143)"
msgstr "STARTTLS (port 143)"

#: src/postulo_imap/sync.py
msgid "Subfolder"
msgstr "Alamkaust"

#: src/postulo_imap/matching.py
msgid "the address of a contact"
msgstr "kontakti aadress"

#: src/postulo_imap/matching.py
msgid "the company’s name in the message"
msgstr "ettevõtte nimi kirjas"

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The folder “%(folder)s” could not be opened."
msgstr "Kausta „%(folder)s“ avamine nurjus."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused the search."
msgstr "Postkast lükkas otsingu tagasi."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to hand over the messages."
msgstr "Postkast keeldus kirju üle andmast."

#: src/postulo_imap/mailbox.py
msgid "The mailbox refused to look for the folder."
msgstr "Postkast keeldus kausta otsimast."

#: src/postulo_imap/mailbox.py
msgid "The messages were read but could not be flagged; the next pass will read them again."
msgstr "Kirjad loeti, kuid neid ei saanud märgistada; järgmine läbikäik loeb need uuesti."

#: src/postulo_imap/mailbox.py
#, python-format
msgid "The messages were read but could not be moved to “%(folder)s”; the next pass will read them again."
msgstr "Kirjad loeti, kuid neid ei saanud kausta „%(folder)s“ teisaldada; järgmine läbikäik loeb need uuesti."

#: src/postulo_imap/mailbox.py
msgid "The messages were read, but this server cannot move them; the next pass will read them again."
msgstr "Kirjad loeti, kuid see server ei saa neid teisaldada; järgmine läbikäik loeb need uuesti."

#: src/postulo_imap/matching.py
msgid "the role’s title in the message"
msgstr "ametikoha nimetus kirjas"

#: src/postulo_imap/matching.py
msgid "the sender’s web domain"
msgstr "saatja veebidomeen"

#: src/postulo_imap/sync.py
msgid "This folder does not keep flags of its own, so Postulo remembers where the last pass stopped instead of flagging what it read."
msgstr ""

#: src/postulo_imap/sync.py
msgid "TLS (port 993)"
msgstr "TLS (port 993)"

#: src/postulo_imap/sync.py
msgid "Used only when messages are moved. Created if missing."
msgstr "Kasutatakse ainult kirjade teisaldamisel. Luuakse, kui puudub."

#: src/postulo_imap/sync.py
msgid "Username"
msgstr "Kasutajanimi"
